---
import { GISCUS } from '../site.config';
import { t, type Lang } from '../lib/i18n';

interface Props {
  /** 用 book slug 做 giscus 的 term，评论按书隔离 */
  term: string;
  lang?: Lang;
}
const { term, lang = 'zh' } = Astro.props;
const enabled = Boolean(GISCUS.repo && GISCUS.repoId && GISCUS.categoryId);
---

<section class="giscus-block">
  <h2 class="giscus-title">{t(lang, 'detail.giscus')}</h2>
  {
    enabled ? (
      <script
        is:inline
        src="https://giscus.app/client.js"
        data-repo={GISCUS.repo}
        data-repo-id={GISCUS.repoId}
        data-category={GISCUS.category}
        data-category-id={GISCUS.categoryId}
        data-mapping="specific"
        data-term={term}
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="top"
        data-theme="dark_dimmed"
        data-lang={lang === 'en' ? 'en' : 'zh-CN'}
        data-loading="lazy"
        crossorigin="anonymous"
        async
      />
    ) : (
      <p class="giscus-placeholder">{t(lang, 'detail.giscusTodo')}</p>
    )
  }
</section>

<style>
  .giscus-block { margin-top: clamp(40px, 7vw, 72px); }
  .giscus-title {
    font-size: 16px;
    letter-spacing: 0.2em;
    color: var(--paper-dim);
    margin: 0 0 18px;
  }
  :global([lang='en']) .giscus-title { letter-spacing: 0.06em; }
  .giscus-placeholder {
    border: 1px dashed var(--line);
    border-radius: 4px;
    padding: 22px;
    font-size: 13px;
    color: var(--paper-faint);
    margin: 0;
  }
</style>

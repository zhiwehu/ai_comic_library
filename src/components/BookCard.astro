---
import type { BookView } from '../lib/books';
import { bookTitle } from '../lib/books';
import { t, type Lang } from '../lib/i18n';
import Pic from './Pic.astro';

interface Props {
  book: BookView;
  index?: number;
  lang?: Lang;
}
const { book, index, lang = 'zh' } = Astro.props;
const no = index !== undefined ? String(index).padStart(2, '0') : null;
const extent =
  book.type === 'series'
    ? t(lang, 'card.chapters', { n: book.chapters.length })
    : t(lang, 'card.pages', { n: book.latest.pages.length });
---

<a
  class="book"
  href={lang === 'en' ? `/en/book/${book.slug}/` : `/book/${book.slug}/`}
  aria-label={bookTitle(book, lang)}
  data-type={book.type}
  data-search={`${book.title} ${book.titleEn ?? ''} ${book.slug}`.toLowerCase()}
>
  {no && <span class="book-no" aria-hidden="true">No.{no}</span>}
  <div class="book-stage">
    <span class="book-ground" aria-hidden="true" />
    <div class="book-cover">
      {book.coverUrl && <Pic src={book.coverUrl} alt={bookTitle(book, lang)} loading="lazy" />}
      <span class="book-veil" aria-hidden="true">
        <span class="veil-title">{bookTitle(book, lang)}</span>
        <span class="veil-meta">{t(lang, `type.${book.type}`)} · {extent}</span>
        <span class="veil-cta">{t(lang, 'card.open')}</span>
      </span>
    </div>
  </div>
  <div class="book-plate">
    <span class="book-title">{bookTitle(book, lang)}</span>
    <span class="book-meta">
      <span class="tag">{t(lang, `type.${book.type}`)}</span>
      {
        book.type === 'series' && (
          <span class="book-upd">{t(lang, 'card.updated', { n: book.latest.number })}</span>
        )
      }
    </span>
  </div>
</a>

<style>
  .book {
    position: relative;
    display: block;
    padding-bottom: 44px;
  }
  /* 舞台：封面 + 接触阴影绑定在一起，阴影永远在封面正下方 */
  .book-stage {
    position: relative;
  }
  .book-ground {
    position: absolute;
    left: 7%;
    right: 7%;
    bottom: -9px;
    height: 15px;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, var(--ground) 0%, transparent 68%);
    filter: blur(2px);
    transition: opacity 0.35s ease, transform 0.35s ease;
  }
  .book:hover .book-ground,
  .book:focus-visible .book-ground {
    opacity: 0.6;
    transform: scaleX(1.07);
  }
  .book-no {
    display: block;
    margin-bottom: 8px;
    font-family: var(--font-latin);
    font-size: 12px;
    letter-spacing: 0.22em;
    color: var(--paper-faint);
    transition: color 0.3s ease;
  }
  .book:hover .book-no, .book:focus-visible .book-no { color: var(--lamp); }
  .book-cover {
    position: relative;
    z-index: 1;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 10px;
    background: var(--ink-3);
    box-shadow:
      0 10px 26px rgba(0, 0, 0, 0.3),
      inset 0 0 0 1px var(--frame-line);
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.3, 1), box-shadow 0.35s ease;
  }
  .book-cover::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.42), rgba(0, 0, 0, 0) 12px);
    pointer-events: none;
  }
  .book-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .book:hover .book-cover,
  .book:focus-visible .book-cover {
    transform: translateY(-8px) scale(1.02);
    box-shadow:
      0 26px 50px rgba(0, 0, 0, 0.4),
      0 10px 44px rgba(232, 180, 90, 0.15),
      inset 0 0 0 1px var(--frame-line);
  }
  .book-veil {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'title title'
      'meta cta';
    gap: 1px 10px;
    padding: 9px 12px 8px;
    background: linear-gradient(180deg, rgba(4, 4, 8, 0), rgba(4, 4, 8, 0.5) 38%, rgba(4, 4, 8, 0.82));
    -webkit-backdrop-filter: blur(10px) saturate(1.3);
    backdrop-filter: blur(10px) saturate(1.3);
    opacity: 0;
    translate: 0 10px;
    transition: opacity 0.3s ease, translate 0.3s ease;
    text-align: left;
  }
  .book:hover .book-veil, .book:focus-visible .book-veil { opacity: 1; translate: 0 0; }
  .veil-title {
    grid-area: title;
    font-family: var(--font-display);
    font-size: 13.5px;
    letter-spacing: 0.05em;
    color: #f5eee0; /* 深色 scrim 之上的定值，不随主题翻 */
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .veil-meta { grid-area: meta; font-size: 11px; letter-spacing: 0.1em; color: rgba(245, 238, 224, 0.72); }
  .veil-cta {
    grid-area: cta;
    align-self: end;
    font-size: 11.5px;
    letter-spacing: 0.22em;
    color: #f2c268;
  }
  .book-plate {
    display: grid;
    gap: 4px;
    margin-top: 26px;
  }
  .book-title {
    font-family: var(--font-display);
    font-size: 15px;
    letter-spacing: 0.06em;
    color: var(--paper);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.3s ease;
  }
  .book:hover .book-title { color: var(--lamp); }
  .book-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
  }
  .book-upd { color: var(--lamp); letter-spacing: 0.05em; white-space: nowrap; }
</style>

---
import Base from '../../layouts/Base.astro';
import BookCard from '../BookCard.astro';
import { getShelf } from '../../lib/books';
import { t, type Lang } from '../../lib/i18n';
import { orgSchema, webSiteSchema } from '../../lib/schema';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const shelf = await getShelf();
const featured = shelf[0] ?? null;
---

<Base
  title={t(lang, 'hero.title')}
  lang={lang}
  ogImage={featured?.coverUrl ?? null}
  schema={[webSiteSchema(lang), orgSchema(lang)]}
>
>
  <section class="shelf wrap" id="shelf">
    <header class="shelf-head">
      <p class="shelf-count">
        <b class="shelf-n">{shelf.length}</b> {t(lang, 'shelf.volumes')}
        <span class="shelf-sub">{t(lang, 'shelf.sub')}</span>
      </p>
    </header>
    <div class="shelf-controls">
      <div class="shelf-search">
        <svg
          class="shelf-search-ico"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="6.5" />
          <path d="M16 16l4 4" stroke-linecap="round" />
        </svg>
        <input
          id="shelf-search"
          type="search"
          placeholder={t(lang, 'shelf.search')}
          autocomplete="off"
          aria-label={t(lang, 'shelf.search')}
        />
        <button class="shelf-clear" id="shelf-clear" type="button" hidden aria-label={t(lang, 'shelf.clear')}
          >✕</button
        >
      </div>
      <div class="shelf-chips" role="group" aria-label={t(lang, 'shelf.all')}>
        {
          ['all', 'series', 'short', 'picture-book'].map((tp) => (
            <button class:list={['chip', { 'is-active': tp === 'all' }]} data-type={tp} type="button">
              {tp === 'all' ? t(lang, 'shelf.all') : t(lang, `type.${tp}`)}
            </button>
          ))
        }
      </div>
    </div>
    <p class="shelf-result" id="shelf-result" aria-live="polite" data-tpl={t(lang, 'shelf.result')} />
    {shelf.length === 0 && <p class="shelf-blank">{t(lang, 'hero.emptyHint')}</p>}
    <div class="shelf-grid" id="shelf-grid">
      {shelf.map((b, i) => <BookCard book={b} index={i + 1} lang={lang} />)}
    </div>
    <div id="shelf-empty" hidden>
      <p class="shelf-empty">{t(lang, 'shelf.empty')}</p>
      <button class="btn btn-ghost" id="shelf-reset" type="button">{t(lang, 'shelf.emptyReset')}</button>
    </div>
    <div class="shelf-morewrap" id="shelf-morewrap" hidden>
      <button class="btn btn-ghost" id="shelf-more" type="button">{t(lang, 'shelf.more')}</button>
    </div>
    <div id="shelf-sentinel" aria-hidden="true" />
  </section>
</Base>

<script>
  /* ---------- 书架：搜索 / 类别过滤 / 分页加载 ---------- */
  const shelfCards = [...document.querySelectorAll<HTMLElement>('#shelf-grid .book')];
  const searchInput = document.getElementById('shelf-search') as HTMLInputElement | null;
  const resultLine = document.getElementById('shelf-result');
  const emptyLine = document.getElementById('shelf-empty');
  const moreWrap = document.getElementById('shelf-morewrap');
  const moreBtn = document.getElementById('shelf-more');
  const sentinel = document.getElementById('shelf-sentinel');

  if (shelfCards.length && searchInput && resultLine && moreWrap && sentinel && emptyLine) {
    const PAGE = 24;
    let query = '';
    let activeType = 'all';
    let shown = PAGE;
    let debounceTimer: ReturnType<typeof setTimeout>;
    const norm = (s: string) => s.toLowerCase().replace(/\s+/g, ' ').trim();
    /** 有输入内容时才显示清除按钮 */
    const syncClear = () => {
      const btn = document.getElementById('shelf-clear') as HTMLButtonElement | null;
      if (btn) btn.hidden = searchInput.value.length === 0;
    };

    function applyShelf() {
      // 外层 if 已保证存在；函数声明会把收窄丢掉，这里补一次（也防 DOM 被替换）
      if (!resultLine || !emptyLine || !moreWrap) return;
      const q = norm(query);
      const matches = shelfCards.filter((card) => {
        const okType = activeType === 'all' || card.dataset.type === activeType;
        const okQuery = !q || norm(card.dataset.search ?? '').includes(q);
        return okType && okQuery;
      });
      for (const card of shelfCards) card.hidden = !matches.includes(card);
      matches.forEach((card, i) => (card.hidden = i >= shown));
      const tpl = resultLine.dataset.tpl ?? '{n}';
      resultLine.textContent = tpl.replace('{n}', String(matches.length));
      emptyLine.hidden = matches.length !== 0;
      moreWrap.hidden = matches.length <= shown;
    }

    function loadMore() {
      shown += PAGE;
      applyShelf();
    }

    searchInput.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      syncClear();
      debounceTimer = setTimeout(() => {
        query = searchInput.value;
        shown = PAGE;
        applyShelf();
      }, 120);
    });

    /* 清除按钮（搜索框内）与空态「清空筛选」共用一套重置逻辑 */
    const clearBtn = document.getElementById('shelf-clear') as HTMLButtonElement | null;
    const resetBtn = document.getElementById('shelf-reset') as HTMLButtonElement | null;
    const resetShelf = () => {
      searchInput.value = '';
      query = '';
      activeType = 'all';
      shown = PAGE;
      document
        .querySelectorAll<HTMLElement>('.shelf-chips .chip')
        .forEach((c) => c.classList.toggle('is-active', c.dataset.type === 'all'));
      syncClear();
      applyShelf();
    };
    clearBtn?.addEventListener('click', () => {
      resetShelf();
      searchInput.focus();
    });
    resetBtn?.addEventListener('click', resetShelf);
    syncClear();

    document.querySelectorAll<HTMLButtonElement>('.shelf-chips .chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        document.querySelectorAll('.shelf-chips .chip').forEach((c) => c.classList.remove('is-active'));
        chip.classList.add('is-active');
        activeType = chip.dataset.type ?? 'all';
        shown = PAGE;
        applyShelf();
      });
    });

    moreBtn?.addEventListener('click', loadMore);

    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting) && !moreWrap!.hidden) loadMore();
      },
      { rootMargin: '600px' }
    );
    io.observe(sentinel);

    applyShelf();
  }
</script>

<style>
  /* ================= 藏书架 ================= */
  .shelf { padding-top: clamp(28px, 4vw, 52px); }
  .shelf-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: clamp(34px, 5vw, 58px);
    border-bottom: 1px solid var(--line);
    padding-bottom: 20px;
  }
  .seal {
    display: grid;
    place-items: center;
    width: clamp(40px, 4.4vw, 60px);
    height: clamp(40px, 4.4vw, 60px);
    border-radius: 8px;
    background: linear-gradient(160deg, #d43a30, var(--seal));
    color: #f7ead6;
    font-family: var(--font-display);
    font-size: clamp(20px, 2.2vw, 30px);
    transform: rotate(7deg);
    box-shadow: inset 0 0 0 2px rgba(247, 234, 214, 0.32), 0 10px 26px rgba(195, 39, 43, 0.32);
  }
  .seal-sm {
    width: 30px;
    height: 30px;
    font-size: 15px;
    transform: rotate(-4deg);
  }
  .shelf-count {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-family: var(--font-latin);
    font-size: 12px;
    letter-spacing: 0.3em;
    color: var(--paper-faint);
  }
  .shelf-n {
    font-size: clamp(38px, 5vw, 60px);
    font-weight: 700;
    color: var(--paper);
    letter-spacing: 0.04em;
  }
  .shelf-sub { letter-spacing: 0.18em; }

  /* ---- 搜索 / 类别过滤（与全站玻璃质感一致）---- */
  .shelf-controls {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin: 0 0 18px;
  }
  .shelf-search {
    position: relative;
    display: flex;
    align-items: center;
    flex: 1 1 240px;
    min-width: 0;
  }
  .shelf-search-ico {
    position: absolute;
    left: 14px;
    width: 15px;
    height: 15px;
    color: var(--paper-faint);
    pointer-events: none;
    transition: color 0.2s ease;
  }
  .shelf-search:focus-within .shelf-search-ico { color: var(--lamp); }
  #shelf-search {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    padding: 11px 40px 11px 38px;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    background: linear-gradient(120deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.012)), var(--glass-bg);
    color: var(--paper);
    font-size: 13.5px;
    letter-spacing: 0.06em;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  #shelf-search::placeholder { color: var(--paper-faint); }
  #shelf-search:focus { border-color: var(--lamp); box-shadow: 0 0 0 3px var(--lamp-soft); }
  /* 自己实现清除按钮，隐藏各浏览器原生那个（外观不统一） */
  #shelf-search::-webkit-search-cancel-button,
  #shelf-search::-webkit-search-decoration { -webkit-appearance: none; appearance: none; }
  .shelf-clear {
    position: absolute;
    right: 7px;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: var(--paper-faint);
    font-size: 12px;
    line-height: 1;
    cursor: pointer;
    transition: color 0.2s ease, background 0.2s ease;
  }
  .shelf-clear:hover { color: var(--paper); background: var(--lamp-soft); }
  .shelf-clear[hidden] { display: none; }

  .shelf-chips { display: flex; gap: 8px; flex-wrap: wrap; }
  .chip {
    padding: 9px 16px;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    background: linear-gradient(120deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.012)), var(--glass-bg);
    color: var(--paper-dim);
    font-size: 12.5px;
    letter-spacing: 0.1em;
    cursor: pointer;
    white-space: nowrap;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }
  .chip:hover { color: var(--paper); border-color: var(--paper-dim); }
  .chip.is-active {
    background: var(--lamp-soft);
    border-color: var(--lamp);
    color: var(--lamp-bright);
  }

  .shelf-result {
    margin: 0 0 24px;
    font-size: 12.5px;
    letter-spacing: 0.18em;
    color: var(--paper-faint);
  }
  .shelf-blank { margin: 0 0 24px; font-size: 14px; color: var(--paper-dim); }
  #shelf-empty { padding: 44px 0 56px; text-align: center; }
  #shelf-empty[hidden] { display: none; }
  .shelf-empty { margin: 0 0 18px; font-size: 14px; color: var(--paper-dim); }
  .shelf-morewrap { display: flex; justify-content: center; margin: 36px 0 8px; }
  .shelf-morewrap[hidden] { display: none; }
  #shelf-sentinel { height: 1px; }

  .shelf-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(138px, 1fr));
    column-gap: 24px;
    row-gap: 58px;
  }
  @media (max-width: 480px) {
    .shelf-grid { grid-template-columns: repeat(auto-fill, minmax(118px, 1fr)); column-gap: 18px; }
  }
  @media (max-width: 560px) {
    .shelf { padding-top: 20px; }
    /* 搜索框独占一行；类别 chips 横向滑动，保证一行放得下且点击目标够大 */
    .shelf-controls { gap: 8px; margin-bottom: 10px; }
    .shelf-search { flex: 1 1 100%; }
    #shelf-search { font-size: 16px; padding: 10px 40px 10px 38px; } /* 16px：iOS 聚焦时不会自动放大整页 */
    .shelf-chips {
      flex-wrap: nowrap;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding-bottom: 2px;
    }
    .shelf-chips::-webkit-scrollbar { display: none; }
    .chip { flex: 0 0 auto; padding: 8px 14px; }
    .shelf-result { margin-bottom: 10px; font-size: 12px; letter-spacing: 0.12em; }

    /* 书架标题与计数上下排列，整体收紧，让第一排书尽早进入首屏 */
    .shelf-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      margin-bottom: 16px;
      padding-bottom: 10px;
    }
    .shelf-count { gap: 8px; }
    .shelf-n { font-size: 30px; }
    .shelf-sub { letter-spacing: 0.1em; }
  }
</style>

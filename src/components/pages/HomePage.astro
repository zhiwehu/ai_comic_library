---
import Base from '../../layouts/Base.astro';
import BookCard from '../BookCard.astro';
import Pic from '../Pic.astro';
import { getShelf, bookTitle } from '../../lib/books';
import { SITE } from '../../site.config';
import { t, fmtDate, type Lang } from '../../lib/i18n';
import { orgSchema, webSiteSchema } from '../../lib/schema';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const shelf = await getShelf();
const featured = shelf[0] ?? null;
const ch = featured?.latest ?? null;
const leftPage = ch?.pages[0];
const rightPage = ch?.pages[1] ?? ch?.pages[0];
const ticker = shelf.map((b) => bookTitle(b, lang)).join('　✦　');
---

<Base
  title={t(lang, 'hero.title')}
  lang={lang}
  ogImage={featured?.coverUrl ?? null}
  schema={[webSiteSchema(lang), orgSchema(lang)]}
>
  {
    featured && ch && leftPage ? (
      <section class="hero" id="hero">
        <span class="ghost" aria-hidden="true">LIBRARY</span>
        <div class="hero-lamp" aria-hidden="true" />
        <aside class="hero-rail" aria-hidden="true">
          <span class="vert">{t(lang, 'hero.rail')}</span>
        </aside>

        <div class="hero-center">
          <p class="kicker">
            {SITE.latinName} · EST. 2026 · {shelf.length} {t(lang, 'hero.kicker')}
          </p>
          <div class="mega-wrap">
            <h1 class="mega">{t(lang, 'hero.title')}</h1>
            <span class="seal" aria-hidden="true">藏</span>
          </div>

          <div class="stage">
            <div class="book3d" id="book3d" style={`--ob-aspect:${(ch.ratio || 8 / 9).toFixed(4)}`}>
              <div class="ob ob-left">
                <span class="edge edge-l" aria-hidden="true" />
                <Pic src={leftPage} alt="" loading="eager" fetchpriority="high" />
              </div>
              {rightPage && (
                <div class="ob ob-right">
                  <span class="edge edge-r" aria-hidden="true" />
                  <Pic src={rightPage} alt="" loading="eager" />
                </div>
              )}
              <span class="gutter" aria-hidden="true" />
              <span class="sweep" aria-hidden="true" />
            </div>
          </div>

          <p class="now-reading">
            <span class="dot" aria-hidden="true" />
            {t(lang, 'hero.now')}　{lang === 'en' ? '' : '《'}{bookTitle(featured, lang)}{lang === 'en' ? '' : '》'} · {ch.title} · {fmtDate(lang, ch.date)}
          </p>
          <div class="cta-row">
            <a class="btn btn-lamp" href={`/read/${featured.slug}/${ch.slug}/`}>
              {t(lang, 'hero.open')}
            </a>
            <a class="btn btn-ghost" id="continue-link" hidden href="#" data-tpl={t(lang, 'hero.continue')} data-base={lang === 'en' ? '/en' : ''} />
          </div>
        </div>

        <div class="ticker" aria-hidden="true">
          <div class="ticker-track">
            <span>{ticker}　✦　</span>
            <span>{ticker}　✦　</span>
          </div>
        </div>
      </section>
    ) : (
      <section class="hero hero-empty wrap">
        <h1 class="mega">{t(lang, 'hero.empty')}</h1>
        <p class="kicker">{t(lang, 'hero.emptyHint')}</p>
      </section>
    )
  }

  <section class="shelf wrap" id="shelf">
    <header class="shelf-head">
      <div class="shelf-title-wrap">
        <h2 class="shelf-title">{t(lang, 'shelf.title')}</h2>
        <span class="seal seal-sm" aria-hidden="true">录</span>
      </div>
      <p class="shelf-count">
        <b class="shelf-n">{shelf.length}</b> {t(lang, 'shelf.volumes')}
        <span class="shelf-sub">{t(lang, 'shelf.sub')}</span>
      </p>
    </header>
    <div class="shelf-controls">
      <div class="shelf-search">
        <svg class="shelf-search-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5" />
          <path d="M16 16l4 4" stroke-linecap="round" />
        </svg>
        <input
          id="shelf-search"
          type="search"
          placeholder={t(lang, 'shelf.search')}
          autocomplete="off"
          aria-label={t(lang, 'shelf.search')}
        />
        <button class="shelf-clear" id="shelf-clear" type="button" hidden aria-label={t(lang, 'shelf.clear')}>✕</button>
      </div>
      <div class="shelf-chips" role="group" aria-label={t(lang, 'shelf.all')}>
        {['all', 'series', 'short', 'picture-book'].map((tp) => (
          <button
            class:list={['chip', { 'is-active': tp === 'all' }]}
            data-type={tp}
            type="button"
          >
            {tp === 'all' ? t(lang, 'shelf.all') : t(lang, `type.${tp}`)}
          </button>
        ))}
      </div>
    </div>
    <p class="shelf-result" id="shelf-result" aria-live="polite" data-tpl={t(lang, 'shelf.result')} />
    <div class="shelf-grid" id="shelf-grid">
      {shelf.map((b, i) => <BookCard book={b} index={i + 1} lang={lang} />)}
    </div>
    <div id="shelf-empty" hidden>
      <p class="shelf-empty">{t(lang, 'shelf.empty')}</p>
      <button class="btn btn-ghost" id="shelf-reset" type="button">{t(lang, 'shelf.emptyReset')}</button>
    </div>
    <div class="shelf-morewrap" id="shelf-morewrap" hidden>
      <button class="btn btn-ghost" id="shelf-more" type="button">{t(lang, 'shelf.more')}</button>
    </div>
    <div id="shelf-sentinel" aria-hidden="true" />
  </section>
</Base>

<script>
  // 「继续上次」
  const link = document.getElementById('continue-link') as HTMLAnchorElement | null;
  const last = localStorage.getItem('cl:last');
  if (link && last) {
    const sep = last.lastIndexOf(':');
    const b = last.slice(0, sep);
    const c = last.slice(sep + 1);
    const p = Number(localStorage.getItem(`cl:progress:${b}:${c}`) ?? 0);
    if (b && c && p > 0) {
      link.href = `${link.dataset.base}/read/${b}/${c}/`;
      link.textContent = link.dataset.tpl!.replace('{p}', String(p));
      link.hidden = false;
    }
  }

  // 开卷 3D：鼠标视差（触屏/减动效自动关闭）
  const hero = document.getElementById('hero');
  const book = document.getElementById('book3d');
  const fine = matchMedia('(pointer: fine)').matches;
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (hero && book && fine && !calm) {
    let raf = 0;
    hero.addEventListener('pointermove', (e) => {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        const r = hero.getBoundingClientRect();
        const dx = (e.clientX - r.left) / r.width - 0.5;
        const dy = (e.clientY - r.top) / r.height - 0.5;
        book.style.setProperty('--ry', `${(dx * 10).toFixed(2)}deg`);
        book.style.setProperty('--rx', `${(6 - dy * 8).toFixed(2)}deg`);
      });
    });
    hero.addEventListener('pointerleave', () => {
      book.style.setProperty('--ry', '0deg');
      book.style.setProperty('--rx', '6deg');
    });
  }

  /* ---------- 书架：搜索 / 类别过滤 / 分页加载 ---------- */
  const shelfCards = [...document.querySelectorAll<HTMLElement>('#shelf-grid .book')];
  const searchInput = document.getElementById('shelf-search') as HTMLInputElement | null;
  const resultLine = document.getElementById('shelf-result');
  const emptyLine = document.getElementById('shelf-empty');
  const moreWrap = document.getElementById('shelf-morewrap');
  const moreBtn = document.getElementById('shelf-more');
  const sentinel = document.getElementById('shelf-sentinel');

  if (shelfCards.length && searchInput && resultLine && moreWrap && sentinel && emptyLine) {
    const PAGE = 24;
    let query = '';
    let activeType = 'all';
    let shown = PAGE;
    let debounceTimer: ReturnType<typeof setTimeout>;
    const norm = (s: string) => s.toLowerCase().replace(/\s+/g, ' ').trim();
    /** 有输入内容时才显示清除按钮 */
    const syncClear = () => {
      const btn = document.getElementById('shelf-clear') as HTMLButtonElement | null;
      if (btn) btn.hidden = searchInput.value.length === 0;
    };

    function applyShelf() {
      // 外层 if 已保证存在；函数声明会把收窄丢掉，这里补一次（也防 DOM 被替换）
      if (!resultLine || !emptyLine || !moreWrap) return;
      const q = norm(query);
      const matches = shelfCards.filter((card) => {
        const okType = activeType === 'all' || card.dataset.type === activeType;
        const okQuery = !q || norm(card.dataset.search ?? '').includes(q);
        return okType && okQuery;
      });
      for (const card of shelfCards) card.hidden = !matches.includes(card);
      matches.forEach((card, i) => (card.hidden = i >= shown));
      const tpl = resultLine.dataset.tpl ?? '{n}';
      resultLine.textContent = tpl.replace('{n}', String(matches.length));
      emptyLine.hidden = matches.length !== 0;
      moreWrap.hidden = matches.length <= shown;
    }

    function loadMore() {
      shown += PAGE;
      applyShelf();
    }

    searchInput.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      syncClear();
      debounceTimer = setTimeout(() => {
        query = searchInput.value;
        shown = PAGE;
        applyShelf();
      }, 120);
    });

    /* 清除按钮（搜索框内）与空态「清空筛选」共用一套重置逻辑 */
    const clearBtn = document.getElementById('shelf-clear') as HTMLButtonElement | null;
    const resetBtn = document.getElementById('shelf-reset') as HTMLButtonElement | null;
    const resetShelf = () => {
      searchInput.value = '';
      query = '';
      activeType = 'all';
      shown = PAGE;
      document
        .querySelectorAll<HTMLElement>('.shelf-chips .chip')
        .forEach((c) => c.classList.toggle('is-active', c.dataset.type === 'all'));
      syncClear();
      applyShelf();
    };
    clearBtn?.addEventListener('click', () => {
      resetShelf();
      searchInput.focus();
    });
    resetBtn?.addEventListener('click', resetShelf);
    syncClear();

    document.querySelectorAll<HTMLButtonElement>('.shelf-chips .chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        document.querySelectorAll('.shelf-chips .chip').forEach((c) => c.classList.remove('is-active'));
        chip.classList.add('is-active');
        activeType = chip.dataset.type ?? 'all';
        shown = PAGE;
        applyShelf();
      });
    });

    moreBtn?.addEventListener('click', loadMore);

    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting) && !moreWrap!.hidden) loadMore();
      },
      { rootMargin: '600px' }
    );
    io.observe(sentinel);

    applyShelf();
  }
</script>

<style>
  /* ================= 首屏 · 满幕开卷 ================= */
  .hero {
    position: relative;
    min-height: 100vh; /* 老引擎回退（旧 WebView 不识别 svh） */
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    padding-block: clamp(56px, 8vh, 96px) clamp(72px, 10vh, 110px);
    border-bottom: 1px solid var(--line);
  }
  .hero-lamp {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(720px 480px at 50% 12%, var(--glow-1), var(--glow-2) 46%, transparent 72%),
      radial-gradient(1100px 560px at 50% 118%, var(--glow-3), transparent 60%);
  }
  .ghost {
    position: absolute;
    top: 2%;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-latin);
    font-size: clamp(120px, 21vw, 320px);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: transparent;
    -webkit-text-stroke: 1px var(--ghost-stroke);
    white-space: nowrap;
    user-select: none;
    pointer-events: none;
  }
  .hero-rail {
    position: absolute;
    right: clamp(14px, 3vw, 40px);
    top: 50%;
    transform: translateY(-50%);
    writing-mode: vertical-rl;
    font-family: var(--font-display);
    font-size: 12.5px;
    letter-spacing: 0.42em;
    color: var(--paper-faint);
    user-select: none;
  }
  @media (max-width: 1080px) { .hero-rail { display: none; } }

  .hero-center { position: relative; text-align: center; }

  .kicker {
    margin: 0 0 clamp(10px, 2vh, 22px);
    font-family: var(--font-latin);
    font-size: 12.5px;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--paper-dim);
    animation: rise 0.9s 0.05s ease both;
  }
  .kicker code { color: var(--lamp); }

  .mega-wrap { position: relative; display: inline-block; }
  .mega {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(52px, 9.5vw, 128px);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: 0.12em;
    text-indent: 0.12em;
    background: linear-gradient(180deg, var(--mega-1) 30%, var(--mega-2) 78%, var(--mega-3));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-shadow: 0 24px 70px var(--mega-glow);
    animation: rise 1s 0.12s ease both;
  }
  :global([lang='en']) .mega {
    font-family: var(--font-latin);
    letter-spacing: 0.02em;
    text-indent: 0;
    font-style: italic;
  }
  .seal {
    position: absolute;
    right: clamp(-30px, -2vw, -14px);
    top: -12px;
    display: grid;
    place-items: center;
    width: clamp(40px, 4.4vw, 60px);
    height: clamp(40px, 4.4vw, 60px);
    border-radius: 8px;
    background: linear-gradient(160deg, #d43a30, var(--seal));
    color: #f7ead6;
    font-family: var(--font-display);
    font-size: clamp(20px, 2.2vw, 30px);
    transform: rotate(7deg);
    box-shadow: inset 0 0 0 2px rgba(247, 234, 214, 0.32), 0 10px 26px rgba(195, 39, 43, 0.32);
    animation: stamp 0.5s 0.75s cubic-bezier(0.2, 1.4, 0.4, 1) both;
  }
  .seal-sm {
    position: static;
    width: 30px;
    height: 30px;
    font-size: 15px;
    transform: rotate(-4deg);
    animation: none;
  }

  /* ---- 3D 开卷 ---- */
  .stage {
    perspective: 1600px;
    margin-top: clamp(-14px, -1vw, -6px);
    animation: rise 1s 0.2s ease both;
  }
  .book3d {
    position: relative;
    display: flex;
    width: min(88vw, 860px);
    margin-inline: auto;
    transform-style: preserve-3d;
    transform: rotateX(var(--rx, 6deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.3, 1);
    animation: floaty 7s ease-in-out infinite;
    filter: drop-shadow(0 44px 70px rgba(0, 0, 0, 0.66)) drop-shadow(0 10px 34px rgba(232, 180, 90, 0.1));
  }
  .ob {
    position: relative;
    width: 50%;
    aspect-ratio: var(--ob-aspect, 8 / 9);
    background: var(--card-bg);
    overflow: hidden;
  }
  .ob img { width: 100%; height: 100%; object-fit: cover; }
  .ob-left {
    border-radius: 6px 0 0 8px;
    box-shadow: inset -26px 0 34px -24px rgba(0, 0, 0, 0.8);
    transform-origin: right center;
    animation: unfold-l 1.2s 0.25s cubic-bezier(0.2, 0.75, 0.3, 1) both;
  }
  .ob-right {
    border-radius: 0 6px 8px 0;
    box-shadow: inset 26px 0 34px -24px rgba(0, 0, 0, 0.8);
    transform-origin: left center;
    animation: unfold-r 1.2s 0.4s cubic-bezier(0.2, 0.75, 0.3, 1) both;
  }
  .edge {
    position: absolute;
    top: 3px;
    bottom: 3px;
    width: 5px;
    z-index: 2;
    pointer-events: none;
    background: repeating-linear-gradient(90deg, #e8dcc2 0 1px, #a99a7c 1px 2.5px);
    opacity: 0.85;
  }
  .edge-l { left: 0; border-radius: 3px 0 0 3px; }
  .edge-r { right: 0; border-radius: 0 3px 3px 0; }

  .gutter {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 48px;
    transform: translateX(-50%);
    background: linear-gradient(90deg, transparent, rgba(0, 0, 0, 0.52) 46%, rgba(0, 0, 0, 0.66) 50%, rgba(0, 0, 0, 0.52) 54%, transparent);
    pointer-events: none;
  }
  .sweep {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(105deg, transparent 42%, rgba(255, 241, 205, 0.11) 50%, transparent 58%);
    background-size: 260% 100%;
    mix-blend-mode: screen;
    animation: sweep 7.5s ease-in-out infinite;
  }

  .now-reading {
    margin: clamp(22px, 3.4vh, 34px) auto 16px;
    font-size: 14px;
    letter-spacing: 0.14em;
    color: var(--paper-dim);
    animation: rise 0.9s 0.55s ease both;
  }
  :global([lang='en']) .now-reading { letter-spacing: 0.04em; }
  .dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--lamp);
    box-shadow: 0 0 12px rgba(232, 180, 90, 0.9);
    margin-right: 6px;
    animation: pulse 2.4s ease-in-out infinite;
  }
  .cta-row {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
    animation: rise 0.9s 0.68s ease both;
  }

  /* ---- 跑马灯：玻璃条 ---- */
  .ticker {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    border-block: 1px solid var(--glass-border);
    background: linear-gradient(120deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.01)), var(--glass-bg);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    backdrop-filter: blur(16px) saturate(1.4);
    padding-block: 12px;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .ticker-track {
    display: flex;
    width: max-content;
    animation: ticker 46s linear infinite;
    font-family: var(--font-display);
    font-size: 13.5px;
    letter-spacing: 0.22em;
    color: var(--paper-faint);
    white-space: nowrap;
  }
  .ticker:hover .ticker-track { animation-play-state: paused; }

  @keyframes ticker { to { transform: translateX(-50%); } }
  @keyframes sweep { 0%, 55%, 100% { background-position: 130% 0; } 25% { background-position: -30% 0; } }
  @keyframes floaty { 0%, 100% { translate: 0 0; } 50% { translate: 0 -8px; } }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
  @keyframes rise {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes stamp {
    from { opacity: 0; transform: rotate(7deg) scale(1.7); }
    to { opacity: 1; transform: rotate(7deg) scale(1); }
  }
  @keyframes unfold-l { from { transform: rotateY(-24deg); } to { transform: rotateY(0); } }
  @keyframes unfold-r { from { transform: rotateY(24deg); } to { transform: rotateY(0); } }

  /* ================= 藏书架 ================= */
  .shelf { padding-top: clamp(52px, 8vw, 96px); }
  .shelf-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: clamp(34px, 5vw, 58px);
    border-bottom: 1px solid var(--line);
    padding-bottom: 20px;
  }
  .shelf-title-wrap { position: relative; display: flex; align-items: flex-start; gap: 12px; }
  .shelf-title {
    margin: 0;
    font-size: clamp(30px, 4.6vw, 52px);
    letter-spacing: 0.26em;
    line-height: 1;
  }
  :global([lang='en']) .shelf-title { letter-spacing: 0.04em; font-style: italic; }
  .shelf-count {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-family: var(--font-latin);
    font-size: 12px;
    letter-spacing: 0.3em;
    color: var(--paper-faint);
  }
  .shelf-n {
    font-size: clamp(38px, 5vw, 60px);
    font-weight: 700;
    color: var(--paper);
    letter-spacing: 0.04em;
  }
  .shelf-sub { letter-spacing: 0.18em; }

  /* ---- 搜索 / 类别过滤（与全站玻璃质感一致）---- */
  .shelf-controls {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin: 0 0 18px;
  }
  .shelf-search {
    position: relative;
    display: flex;
    align-items: center;
    flex: 1 1 240px;
    min-width: 0;
  }
  .shelf-search-ico {
    position: absolute;
    left: 14px;
    width: 15px;
    height: 15px;
    color: var(--paper-faint);
    pointer-events: none;
    transition: color 0.2s ease;
  }
  .shelf-search:focus-within .shelf-search-ico { color: var(--lamp); }
  #shelf-search {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    padding: 11px 40px 11px 38px;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    background: linear-gradient(120deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.012)), var(--glass-bg);
    color: var(--paper);
    font-size: 13.5px;
    letter-spacing: 0.06em;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  #shelf-search::placeholder { color: var(--paper-faint); }
  #shelf-search:focus { border-color: var(--lamp); box-shadow: 0 0 0 3px var(--lamp-soft); }
  /* 自己实现清除按钮，隐藏各浏览器原生那个（外观不统一） */
  #shelf-search::-webkit-search-cancel-button,
  #shelf-search::-webkit-search-decoration { -webkit-appearance: none; appearance: none; }
  .shelf-clear {
    position: absolute;
    right: 7px;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: var(--paper-faint);
    font-size: 12px;
    line-height: 1;
    cursor: pointer;
    transition: color 0.2s ease, background 0.2s ease;
  }

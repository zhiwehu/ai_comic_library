---
import Base from '../../layouts/Base.astro';
import { chapterNav, bookTitle, bookDesc } from '../../lib/books';
import { t, type Lang } from '../../lib/i18n';
import { breadcrumbSchema, issueSchema } from '../../lib/schema';
import Giscus from '../Giscus.astro';

interface Props {
  lang: Lang;
  book: any;
  chapter: any;
}
const { lang, book, chapter } = Astro.props;
const { prev, next } = chapterNav(book, chapter.slug);
const pages = chapter.pages;
const count = pages.length;
const base = lang === 'en' ? '/en' : '';
const ratio = chapter.ratio && chapter.ratio > 0 ? chapter.ratio : 8 / 9;
/** meta description：书名 · 章题 — 简介（截到 160 字符内，利于搜索摘要） */
const rawDesc = `${bookTitle(book, lang)} · ${chapter.title} — ${bookDesc(book, lang)}`;
const description = rawDesc.length > 160 ? `${rawDesc.slice(0, 157)}…` : rawDesc;
const pageAlt = (i: number) => `${bookTitle(book, lang)} · ${t(lang, 'reader.pageAlt', { n: i + 1 })}`;
---

<Base
  title={`${bookTitle(book, lang)} · ${chapter.title}`}
  lang={lang}
  description={description}
  ogImage={pages[0] ?? null}
  ogType="article"
  bodyClass="reader-page"
  chrome={false}
  schema={[
    breadcrumbSchema(
      [
        { name: t(lang, 'site.name'), path: '/' },
        { name: bookTitle(book, lang), path: `/book/${book.slug}/` },
        { name: chapter.title, path: `/read/${book.slug}/${chapter.slug}/` },
      ],
      lang
    ),
    ...(book.type === 'series'
      ? [{ '@context': 'https://schema.org', '@type': 'WebPage', name: `${bookTitle(book, lang)} · ${chapter.title}`, inLanguage: lang === 'en' ? 'en-US' : 'zh-CN', mainEntity: issueSchema(book, chapter, lang) }]
      : []),
  ]}
>
  <div
    id="reader"
    style={`--page-aspect:${ratio.toFixed(4)}`}
    data-page-aspect={ratio.toFixed(4)}
    data-book={book.slug}
    data-chapter={chapter.slug}
    data-count={count}
    data-base-path={base === '/en' ? '/en/' : '/'}
    data-prev={prev ? `${base}/read/${book.slug}/${prev.slug}/` : ''}
    data-next={next ? `${base}/read/${book.slug}/${next.slug}/` : ''}
    data-next-title={next?.title ?? ''}
    data-toast-restore={t(lang, 'reader.toastRestore')}
    data-toast-undo={t(lang, 'reader.undo')}
    data-end-kicker={t(lang, 'reader.endKicker')}
    data-end-last-kicker={t(lang, 'reader.endLastKicker')}
    data-end-next={t(lang, 'reader.endNext')}
    data-end-done={t(lang, 'reader.endDone')}
    data-mode-flip={t(lang, 'reader.modeFlip')}
    data-mode-scroll={t(lang, 'reader.modeScroll')}
    data-auto={t(lang, 'reader.auto')}
    data-hint={t(lang, 'reader.hint')}
    data-speed-tpl={t(lang, 'reader.speedVal')}
  >
    <p class="sr-only">
      {bookTitle(book, lang)} · {chapter.title} · {t(lang, 'reader.pageCount', { n: count })} · {bookDesc(book, lang)}
    </p>

    <div class="chrome" id="chrome">
      <div class="chrome-top">
        <a class="cr-btn cr-back" href={`${base}/book/${book.slug}/`}>{t(lang, 'reader.back')}</a>
        <span class="cr-title">{bookTitle(book, lang)} · {chapter.title}</span>
        <span class="cr-actions">
          {
            prev && (
              <a class="cr-btn" id="lnk-prev" href={`${base}/read/${book.slug}/${prev.slug}/`}>
                {t(lang, 'reader.prev')}
              </a>
            )
          }
          {
            next && (
              <a class="cr-btn" id="lnk-next" href={`${base}/read/${book.slug}/${next.slug}/`}>
                {t(lang, 'reader.next')}
              </a>
            )
          }
          <button class="cr-btn" id="btn-thumbs" type="button">{t(lang, 'reader.thumbs')}</button>
          <button class="cr-btn" id="btn-auto" type="button" aria-pressed="false">{t(lang, 'reader.auto')}</button>
          <button class="cr-btn" id="btn-mode" type="button">{t(lang, 'reader.modeScroll')}</button>
          <button class="cr-btn" id="btn-full" type="button">{t(lang, 'reader.full')}</button>
          <button class="cr-btn" id="btn-theme" data-theme-toggle type="button" aria-label={t(lang, 'theme.toggle')} title={t(lang, 'theme.toggle')}><span class="icon-moon" aria-hidden="true">☾</span><span class="icon-sun" aria-hidden="true">☀</span></button>
        </span>
      </div>
      <div class="chrome-bottom">
        <input type="range" id="slider" min="1" max={count} value="1" step="1" aria-label={t(lang, 'reader.slider')} />
        <span id="page-indicator" aria-live="polite">1 / {count}</span>
      </div>
      <div class="auto-speed" id="auto-speed" hidden>
        <span class="as-label">{t(lang, 'reader.autoSpeed')}</span>
        <input
          type="range"
          id="speed-range"
          min="2"
          max="20"
          step="1"
          value="5"
          aria-label={t(lang, 'reader.autoSpeed')}
        />
        <span class="as-val" id="speed-val" aria-live="polite"></span>
      </div>
    </div>

    <!-- 滚动模式（默认可见 = 无 JS 也能读） -->
    <div id="scrollbook">
      {
        pages.map((url: string, i: number) => (
          <div class="scroll-page" data-idx={i}>
            <picture>
              <source srcset={url} type="image/webp" />
              <img
                src={url.replace(/\.webp$/, '.jpg')}
                alt={pageAlt(i)}
                loading="lazy"
                decoding="async"
                draggable={false}
              />
            </picture>
          </div>
        ))
      }
      <!-- 读完页：滚动模式=scrollbook 内最后一个区块；翻页模式=覆盖层（JS 切换） -->
      <section class="afterword" id="afterword" aria-label={t(lang, 'reader.afterwordTitle')}>
        <div class="afterword-inner">
          <p class="afterword-kicker">{t(lang, 'reader.afterwordKicker')}</p>
          <h2 class="afterword-title">{t(lang, 'reader.afterwordTitle')}</h2>
          <p class="afterword-lead">{t(lang, 'reader.afterwordLead')}</p>
          <div class="afterword-comments" id="comments">
            <Giscus term={book.slug} lang={lang} />
          </div>
          <div class="afterword-nav">
            {
              next && (
                <a class="afterword-next" href={`${base}/read/${book.slug}/${next.slug}/`}>
                  {t(lang, 'reader.endNext', { t: next.title })}
                </a>
              )
            }
            <button class="afterword-prev" id="afterword-prev" type="button">{t(lang, 'reader.restart')}</button>
            <a class="afterword-back" href={`${base}/book/${book.slug}/`}>{t(lang, 'reader.backHome')}</a>
          </div>
        </div>
      </section>
    </div>

    <!-- 翻页模式 -->
    <div class="flip-stage" id="flip-stage" hidden>
      <div id="flipbook">
        {
          pages.map((url: string, i: number) => (
            <div class="pf-page">
              <img
                data-src={url}
                data-jpg={url.replace(/\.webp$/, '.jpg')}
                alt={pageAlt(i)}
                draggable={false}
              />
            </div>
          ))
        }
      </div>
    </div>

    <!-- 读完页（最后一页之后的独立一页，两种模式共用）：评论区 + 返回目录 -->
    <!-- 缩略图网格 -->
    <div id="thumbs" hidden>
      <div class="thumbs-head">
        <span class="thumbs-title">{t(lang, 'reader.thumbsTitle', { n: count })}</span>
        <button class="cr-btn thumbs-close" id="btn-thumbs-close" type="button" aria-label={t(lang, 'reader.close')}>✕</button>
      </div>
      <div class="thumbs-grid">
        {
          pages.map((url: string, i: number) => (
            <button type="button" data-page={i + 1} aria-label={t(lang, 'reader.jumpAlt', { n: i + 1 })}>
              <img data-src={url} data-jpg={url.replace(/\.webp$/, '.jpg')} alt="" loading="lazy" />
              <span>{i + 1}</span>
            </button>
          ))
        }
      </div>
    </div>

    <!-- 章末引导卡 -->
    <div id="endcard" hidden>
      <a id="endcard-link" href="#">
        <span class="endcard-kicker" id="endcard-kicker" />
        <span class="endcard-title" id="endcard-title" />
      </a>
    </div>

    <div id="toast" hidden>
      <span id="toast-text" />
      <button id="toast-undo" type="button" hidden />
    </div>

    <!-- 边缘呼出区：点上下边缘显示工具栏 -->
    <div class="edge-strip top" aria-hidden="true" />
    <div class="edge-strip bottom" aria-hidden="true" />

    <noscript>
      <style>
        .chrome, .edge-strip { display: none !important; }
      </style>
    </noscript>
  </div>
</Base>

<script>
  import { PageFlip } from 'page-flip';

  const root = document.getElementById('reader')!;
  const bookSlug = root.dataset.book!;
  const chapterSlug = root.dataset.chapter!;
  const count = Number(root.dataset.count);
  const nextUrl = root.dataset.next || null;
  const nextTitle = root.dataset.nextTitle || '';
  const STR = {
    toastRestore: root.dataset.toastRestore!,
    toastUndo: root.dataset.toastUndo!,
    endKicker: root.dataset.endKicker!,
    endLastKicker: root.dataset.endLastKicker!,
    endNext: root.dataset.endNext!,
    endDone: root.dataset.endDone!,
    modeFlip: root.dataset.modeFlip!,
    modeScroll: root.dataset.modeScroll!,
    hint: root.dataset.hint!,
  };
  const key = `cl:progress:${bookSlug}:${chapterSlug}`;

  const chrome = document.getElementById('chrome')!;
  const scrollbook = document.getElementById('scrollbook')!;
  const flipStage = document.getElementById('flip-stage')!;
  const flipbook = document.getElementById('flipbook')!;
  const slider = document.getElementById('slider') as HTMLInputElement;
  const indicator = document.getElementById('page-indicator')!;
  const thumbs = document.getElementById('thumbs')!;
  const endcard = document.getElementById('endcard')!;
  const endcardLink = document.getElementById('endcard-link') as HTMLAnchorElement;
  const endcardKicker = document.getElementById('endcard-kicker')!;
  const endcardTitle = document.getElementById('endcard-title')!;
  const toast = document.getElementById('toast')!;
  const toastText = document.getElementById('toast-text')!;
  const toastUndo = document.getElementById('toast-undo') as HTMLButtonElement;
  const modeBtn = document.getElementById('btn-mode') as HTMLButtonElement;

  const saved = Math.min(Math.max(Number(localStorage.getItem(key) ?? 1) || 1, 1), count);
  let mode: 'flip' | 'scroll' = localStorage.getItem('cl:mode') === 'scroll' ? 'scroll' : 'flip';

  let pf: PageFlip | null = null;
  let flipImgs: HTMLImageElement[] = [];
  let sections: HTMLElement[] = [];
  let orientation: 'portrait' | 'landscape' = 'portrait';
  let endShown = false;
  let toastTimer: ReturnType<typeof setTimeout> | undefined;
  const afterwordEl = document.getElementById('afterword');

  /** 视图（views）：对开模式 = 跨页，单页/滚动 = 页。滑条与 endcard 以视图为刻度。 */
  let perView = 1;
  let viewsCount = count;
  let viewIdx = 0;

  /** 页盒基准尺寸按真实页宽高比换算（客户端现算，flipW/flipH 来自 data-page-aspect） */
  const pageAspectCfg = Number(root.dataset.pageAspect) || 8 / 9;
  const flipW = Math.round(pageAspectCfg >= 1 ? 900 : 800);
  const flipH = Math.round(flipW / pageAspectCfg);

  function computeViews() {
    perView = mode === 'flip' && orientation === 'landscape' ? 2 : 1;
    viewsCount = Math.ceil(count / perView);
    slider.max = String(viewsCount);
  }
  const viewOfPage = (page1: number) => Math.min(viewsCount - 1, Math.ceil(page1 / perView) - 1);
  const leftPageOfView = (v: number) => Math.min(count, v * perView + 1);
  let afterwordOn = false;

  const save = (p: number) => {
    localStorage.setItem(key, String(p));
    localStorage.setItem('cl:last', `${bookSlug}:${chapterSlug}`);
  };

  /** 读完页：翻页模式=全屏覆盖层；滚动模式=scrollbook 内区块（始终在文档流，无需显隐） */
  function showAfterword() {
    if (afterwordOn) return;
    afterwordOn = true;
    endcard.hidden = true;
    endShown = true;
    if (mode === 'flip') {
      // 挪出 scrollbook 挂到 reader 根部 + 覆盖层样式（scrollbook 已被 hidden，留着无碍但挪出更稳）
      afterwordEl.classList.add('as-overlay');
      root.appendChild(afterwordEl);
      afterwordEl.hidden = false;
      afterwordEl.scrollTo(0, 0);
    }
    indicator.textContent = `${count} / ${count} ✓`;
    slider.value = String(viewsCount);
    slider.style.setProperty('--fill', '100%');
    save(count);
  }
  function hideAfterword() {
    if (!afterwordOn) return;
    afterwordOn = false;
    if (mode === 'flip') afterwordEl.hidden = true;
  }

  // 覆盖层内部滚动到顶部后再向上滑（overscroll）→ 关闭覆盖层回末页（移动端自然手势，仅翻页模式）
  const sc = afterwordEl;
  let afterwordTouchY = 0;
  sc.addEventListener(
    'touchstart',
    () => {
      if (sc.scrollTop <= 0) sc.dataset.atTop = '1';
    },
    { passive: true }
  );
  sc.addEventListener(
    'touchmove',
    (e) => {
      if (sc.dataset.atTop === '1' && e.touches[0].clientY > afterwordTouchY + 36 && afterwordOn) {
        sc.dataset.atTop = '';
        stopAuto();
        goLastPage();
      }
    },
    { passive: true }
  );
  afterwordEl.addEventListener('touchstart', (e) => (afterwordTouchY = e.touches[0].clientY), { passive: true });

  function setView(v: number, pageForSave: number) {
    viewIdx = Math.min(Math.max(v, 0), viewsCount - 1);
    hideAfterword();
    const left = leftPageOfView(viewIdx);
    const right = Math.min(left + perView - 1, count);
    indicator.textContent = perView === 1 || left === right ? `${left} / ${count}` : `${left}–${right} / ${count}`;
    if (Number(slider.value) !== viewIdx + 1) slider.value = String(viewIdx + 1);
    const pct = viewsCount > 1 ? Math.round((viewIdx / (viewsCount - 1)) * 100) : 100;
    slider.style.setProperty('--fill', `${pct}%`);
    save(pageForSave);
    updateEndcard(viewIdx);
  }

  function preloadFlip(cur: number) {
    const from = Math.max(0, cur - 2);
    const to = Math.min(count - 1, cur + 3);
    for (let i = from; i <= to; i++) {
      const img = flipImgs[i];
      if (img?.dataset.src && !img.src) img.src = img.dataset.src;
    }
  }

  function showToast(text: string, undo?: () => void) {
    toastText.textContent = text;
    toastUndo.textContent = STR.toastUndo;
    toastUndo.hidden = !undo;
    toastUndo.onclick = undo ?? null;
    toast.hidden = false;
    clearTimeout(toastTimer);
    // 带「从头看」按钮的多留一会儿，方便看清和点按
    toastTimer = setTimeout(() => (toast.hidden = true), undo ? 6000 : 4200);
  }
  // 点提示条空白处即可收起（按钮除外）
  toast.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('button')) return;
    toast.hidden = true;
    clearTimeout(toastTimer);
  });

  function updateEndcard(v: number) {
    // endcard 只在「最后一页之后再翻一页」（即读完页）出现，最后一页本身保持干净
    const atEnd = v >= viewsCount;
    if (atEnd && !endShown) {
      endShown = true;
      if (nextUrl) {
        endcardKicker.textContent = STR.endKicker;
        endcardTitle.textContent = STR.endNext.replace('{t}', nextTitle);
        endcardLink.href = nextUrl;
      } else {
        // 读完页没有「返回书架」卡——afterword 区已带返回目录链接，这里只显示下一话引导
        endcard.hidden = true;
        return;
      }
      endcard.hidden = false;
    } else if (!atEnd && endShown) {
      endShown = false;
      endcard.hidden = true;
    }
  }

  /* ---------- 翻页模式 ---------- */
  function fitFlip() {
    if (!pf) return;
    const stage = flipStage.getBoundingClientRect();
    const availW = stage.width - 20;
    const availH = stage.height - 116;
    const pageAspect = Number(root.dataset.pageAspect) || 8 / 9;
    let pageW =
      orientation === 'portrait'
        ? Math.min(availW, availH * pageAspect)
        : Math.min(availW / 2, availH * pageAspect);
    // StPageFlip 以 blockWidth < 2*minWidth 判定 portrait：页宽落进死区会单/双页抖动
    if (pageW >= 560 && pageW < 680) pageW = 680;
    flipbook.style.width = `${Math.floor(pageW * (orientation === 'portrait' ? 1 : 2))}px`;
    window.dispatchEvent(new Event('resize'));
  }

  function initFlip(startPage: number) {
    scrollbook.hidden = true;
    flipStage.hidden = false;
    modeBtn.textContent = STR.modeScroll;

    pf = new PageFlip(flipbook, {
      width: flipW,
      height: flipH,
      size: 'stretch',
      minWidth: 280,
      maxWidth: Math.round(flipW * 1.15),
      minHeight: 360,
      maxHeight: Math.round(flipH * 1.15),
      usePortrait: true,
      showCover: false,
      mobileScrollSupport: true,
      maxShadowOpacity: 0.5,
      flippingTime: 620,
      // 库自带的滑动翻页在 disableFlipByClick 下同样会被角点检查拦掉（后退方向必失效），
      // 这里把它关掉（阈值设到不可能达到），滑动翻页由我们自己的 pointer 处理统一接管
      swipeDistance: 99999,
      startPage: startPage - 1,
      disableFlipByClick: true, // 翻页交给左右点击区：中央轻点呼出工具栏
      // 关掉库自带的鼠标/触摸事件：它的 onTouchStart 有 250ms 延迟的 startUserTouch，
      // 轻点持续 ≥250ms 时它的 userStop() 也会 flip 一次，和我们的 pointerup 翻页叠加
      // 造成「点一下翻两页」。翻页手势全部由下面的 pointerdown/pointerup 自己处理。
      useMouseEvents: false,
    });
    pf.loadFromHTML(flipbook.querySelectorAll('.pf-page'));
    flipImgs = [...flipbook.querySelectorAll('img')];
    computeViews();

    pf.on('flip', (e: { data: number }) => {
      const leftIdx = Number(e.data ?? 0);
      // 自动翻页自己发起的翻页不该把自己停掉；只有用户手动翻页才停
      if (autoFlipping) autoFlipping = false;
      else stopAuto();
      // 翻到最后一页正常显示；「翻过最后一页」由 flipAtPoint 在末页再翻时主动处理
      // （库在末页 flipNext 无页可翻、不发 flip 事件），这里不做 afterword 判定
      hideAfterword();
      setView(viewOfPage(leftIdx + 1), leftIdx + 1);
      preloadFlip(leftIdx);
    });
    pf.on('changeOrientation', (e: { data: 'portrait' | 'landscape' }) => {
      orientation = e.data;
      computeViews();
      fitFlip();
      setView(viewIdx, leftPageOfView(viewIdx));
    });
    pf.on('init', () => {
      orientation = pf!.getOrientation();
      computeViews();
      fitFlip();
      setView(viewOfPage(startPage), startPage);
    });

    setView(viewOfPage(startPage), startPage);
    preloadFlip(startPage - 1);
    if (startPage > 1) {
      showToast(STR.toastRestore.replace('{p}', String(startPage)), () => {
        localStorage.removeItem(key);
        location.reload();
      });
    }
  }

  /* ---------- 滚动模式 ---------- */
  function initScroll(startPage: number) {
    flipStage.hidden = true;
    scrollbook.hidden = false;
    modeBtn.textContent = STR.modeFlip;
    computeViews();

    sections = [...scrollbook.querySelectorAll<HTMLElement>('.scroll-page')];
    const awEl = document.getElementById('afterword');
    const io = new IntersectionObserver(
      (entries) => {
        for (const en of entries) {
          if (!en.isIntersecting) continue;
          const el = en.target as HTMLElement;
          if (el === awEl) {
            // 滚到读完页：指示器打 ✓，进度存最后一页
            afterwordOn = true;
            endcard.hidden = true;
            endShown = true;
            indicator.textContent = `${count} / ${count} ✓`;
            slider.value = String(viewsCount);
            slider.style.setProperty('--fill', '100%');
            save(count);
            continue;
          }
          if (afterwordOn) {
            afterwordOn = false;
            endShown = false;
          }
          const p = Number(el.dataset.idx) + 1;
          setView(viewOfPage(p), p);
        }
      },
      { root: scrollbook, threshold: 0.6 }
    );
    sections.forEach((s) => io.observe(s));
    if (awEl) io.observe(awEl);

    if (startPage > 1) {
      requestAnimationFrame(() =>
        sections[startPage - 1]?.scrollIntoView({ behavior: 'instant' as ScrollBehavior })
      );
      showToast(STR.toastRestore.replace('{p}', String(startPage)), () => {
        localStorage.removeItem(key);
        location.reload();
      });
    }
  }

  /** 用**书上的真实坐标**发起翻页（左右观感一致的关键）
   *
   *  StPageFlip 的 flipNext()/flipPrev() 内部用的是写死的屏幕坐标：
   *  flipPrev() 取 x=10 —— 书居中时这一点甚至不在书上，卷页起点跑偏，
   *  所以「左翻」看起来和「右翻」不是一个效果；同时 disableFlipByClick=true 时
   *  这个点过不了角点检查，后退翻页还会被静默拦掉。
   *  这里把真实触点交给 flipController.flip()，并在调用瞬间放开开关、调用后恢复。
   */
  function flipAtPoint(x: number, y: number, dir: 1 | -1) {
    if (!pf) return;
    // 已在最后一页再往前翻 → 库不会再发 flip 事件（无页可翻），直接打开读完页
    if (dir > 0 && viewIdx >= viewsCount - 1) {
      showAfterword();
      return;
    }
    if (afterwordOn && dir < 0) {
      goLastPage();
      return;
    }
    const st = pf.getSettings();
    const saved = st.disableFlipByClick;
    st.disableFlipByClick = false;
    try {
      const fc = pf.getFlipController();
      if (fc && typeof fc.flip === 'function') fc.flip({ x, y });
      else if (dir > 0) pf.flipNext();
      else pf.flipPrev();
    } finally {
      st.disableFlipByClick = saved;
    }
  }

  /** 翻页动画锁：page-flip 一次动画约 620ms，动画未结束时再发翻页请求
   *  会落在错误页位上（按住方向键就连翻到头/尾），所以动画期间直接忽略 */
  let flipLockUntil = 0;
  const FLIP_LOCK_MS = 650;

  /** 无触点场景（键盘、自动翻页、缩略图跳页）：取书上左右底的对称坐标，
   *  让两个方向的卷页起点对称 */
  /** 点击翻页同样走动画锁：动画未结束时忽略再次点击，避免一次轻点连翻两页 */
  function tapFlipAtPoint(x: number, y: number, dir: 1 | -1) {
    if (!pf) return;
    if (Date.now() < flipLockUntil) return;
    flipLockUntil = Date.now() + FLIP_LOCK_MS;
    flipAtPoint(x, y, dir);
  }

  function flipBy(dir: 1 | -1) {
    if (!pf) return;
    if (Date.now() < flipLockUntil) return;
    flipLockUntil = Date.now() + FLIP_LOCK_MS;
    const rect = pf.getBoundsRect();
    if (rect && rect.width > 0 && rect.height > 0) {
      const y = rect.top + rect.height * 0.82;
      const x = dir > 0 ? rect.left + rect.width - 14 : rect.left + 14;
      flipAtPoint(x, y, dir);
      return;
    }
    flipAtPoint(window.innerWidth * (dir > 0 ? 0.8 : 0.2), window.innerHeight * 0.6, dir);
  }

  function scrollByPage(dir: 1 | -1) {
    if (afterwordOn) {
      if (dir < 0) goLastPage();
      return; // 读完页上方向键不滚动评论区
    }
    const cur = Number(slider.value);
    // 已在最后一页再往下 → 打开读完页覆盖层
    if (dir > 0 && viewIdx >= viewsCount - 1) {
      showAfterword();
      return;
    }
    const target = sections[Math.min(viewsCount, Math.max(1, cur + dir)) - 1];
    target?.scrollIntoView({ behavior: 'smooth' });
  }

  /** 关闭读完页并回到最后一页（两种模式通用） */
  function goLastPage() {
    hideAfterword();
    const lastView = viewsCount - 1;
    if (mode === 'flip') pf?.turnToPage(lastView * perView);
    else sections[lastView]?.scrollIntoView({ behavior: 'smooth' });
    setView(lastView, lastView * perView + 1);
  }

  /* ---------- 启动 ---------- */
  computeViews();
  setIndicatorInit(saved);
  function setIndicatorInit(p: number) {
    indicator.textContent = `${p} / ${count}`;
    slider.value = String(viewOfPage(p) + 1);
  }
  if (mode === 'flip') initFlip(saved);
  else initScroll(saved);

  /* ---------- 控件 ---------- */
  slider.addEventListener('input', () => {
    const v = Number(slider.value) - 1;
    const left = leftPageOfView(v);
    const right = Math.min(left + perView - 1, count);
    indicator.textContent = perView === 1 ? `${left} / ${count}` : `${left}–${right} / ${count}`;
    const pct = viewsCount > 1 ? Math.round((v / (viewsCount - 1)) * 100) : 100;
    slider.style.setProperty('--fill', `${pct}%`);
  });
  slider.addEventListener('change', () => {
    stopAuto();
    const v = Number(slider.value) - 1;
    hideAfterword();
    if (mode === 'flip') pf?.turnToPage(v * perView);
    else sections[v]?.scrollIntoView({ behavior: 'smooth' });
    setView(v, v * perView + 1);
  });

  modeBtn.addEventListener('click', () => {
    localStorage.setItem('cl:mode', mode === 'flip' ? 'scroll' : 'flip');
    location.reload(); // 进度按页保存，切换零损耗
  });

  document.getElementById('btn-full')!.addEventListener('click', () => {
    if (document.fullscreenElement) document.exitFullscreen();
    else document.documentElement.requestFullscreen?.().catch(() => {});
  });

  /** 高亮当前正在读的页（对开模式高亮两页），并把它滚到视野中央 */
  function markThumbs() {
    const v = Number(slider.value) - 1;
    const left = leftPageOfView(v);
    const right = Math.min(left + perView - 1, count);
    let firstOn: HTMLElement | undefined;
    for (const b of thumbs.querySelectorAll<HTMLElement>('[data-page]')) {
      const p = Number(b.dataset.page);
      const on = p >= left && p <= right;
      b.classList.toggle('is-active', on);
      if (on) {
        b.setAttribute('aria-current', 'page');
        firstOn ??= b;
      } else {
        b.removeAttribute('aria-current');
      }
    }
    firstOn?.scrollIntoView({ block: 'center', behavior: 'instant' as ScrollBehavior });
  }

  document.getElementById('btn-thumbs')!.addEventListener('click', () => {
    thumbs.hidden = false;
    thumbs.querySelectorAll('img').forEach((im) => {
      const el = im as HTMLImageElement;
      if (el.dataset.src && !el.src) el.src = el.dataset.src;
    });
    requestAnimationFrame(markThumbs);
  });
  document.getElementById('btn-thumbs-close')!.addEventListener('click', () => (thumbs.hidden = true));
  thumbs.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-page]');
    if (!btn) return;
    const p = Number(btn.dataset.page);
    thumbs.hidden = true;
    if (mode === 'flip') pf?.turnToPage(p - 1);
    else sections[p - 1]?.scrollIntoView();
    setView(viewOfPage(p), p);
  });

  window.addEventListener('keydown', (e) => {
    // 焦点在滑条/输入框时，方向键归控件自己用（例如用 ←/→ 微调自动翻页速度），
    // 不当作翻页手势、也不打断自动翻页
    const t = e.target as HTMLElement | null;
    if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;
    stopAuto();
    if (e.key === 'Escape' && !thumbs.hidden) {
      thumbs.hidden = true;
      return;
    }
    if (e.key === 'ArrowRight' || e.key === 'PageDown') {
      if (afterwordOn) return; // 读完页：方向键交给评论区（giscus 输入框），不再翻页
      if (mode === 'flip') flipBy(1);
      else scrollByPage(1);
    } else if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
      if (afterwordOn) {
        // 读完页后退：关闭覆盖层回最后一页
        stopAuto();
        goLastPage();
        return;
      }
      if (mode === 'flip') flipBy(-1);
      else scrollByPage(-1);
    }
  });

  /* ---------- 沉浸式 chrome：默认隐藏，按需呼出 ---------- */
  let hideTimer: ReturnType<typeof setTimeout>;
  function wake() {
    if (chrome.classList.contains('chrome-on')) {
      clearTimeout(hideTimer);
      hideTimer = setTimeout(hide, 2200);
      return;
    }
    chrome.classList.add('chrome-on');
    hideTimer = setTimeout(hide, 2600);
  }

  /* ---------- 自动翻页 ---------- */
  const autoBtn = document.getElementById('btn-auto');
  const speedWrap = document.getElementById('auto-speed') as HTMLElement | null;
  const speedRange = document.getElementById('speed-range') as HTMLInputElement | null;
  const speedVal = document.getElementById('speed-val');
  const SPEED_KEY = 'cl:auto-speed';
  const SPEED_DEFAULT = 5;
  const SPEED_MIN = 2;
  const SPEED_MAX = 20;
  let autoTimer: ReturnType<typeof setInterval> | null = null;
  /** 本次翻页是否由自动翻页发起（用于区分"自动"与"用户手动"，前者不该停表） */
  let autoFlipping = false;

  /** 速度：秒/视图，持久化到 localStorage（跨书、跨章沿用） */
  let autoSpeed = SPEED_DEFAULT;
  try {
    const saved = Number(localStorage.getItem(SPEED_KEY));
    if (Number.isFinite(saved) && saved >= SPEED_MIN && saved <= SPEED_MAX) autoSpeed = saved;
  } catch {}

  function renderSpeed() {
    if (speedRange) {
      speedRange.value = String(autoSpeed);
      const pct = ((autoSpeed - SPEED_MIN) / (SPEED_MAX - SPEED_MIN)) * 100;
      speedRange.style.setProperty('--fill', `${pct}%`);
    }
    if (speedVal) {
      const tpl = root.dataset.speedTpl || '{n}';
      speedVal.textContent = tpl.replace('{n}', String(autoSpeed));
    }
  }

  function stopAuto() {
    if (autoTimer === null) return;
    clearInterval(autoTimer);
    autoTimer = null;
    autoBtn?.classList.remove('is-active');
    autoBtn?.setAttribute('aria-pressed', 'false');
    if (speedWrap) speedWrap.hidden = true;
  }
  function startAuto() {
    stopAuto();
    autoBtn?.classList.add('is-active');
    autoBtn?.setAttribute('aria-pressed', 'true');
    renderSpeed();
    if (speedWrap) speedWrap.hidden = false;
    autoTimer = setInterval(() => {
      if (viewIdx >= viewsCount - 1) {
        stopAuto();
        return;
      }
      if (mode === 'flip') {
        autoFlipping = true;
        pf?.flipNext();
        // 兜底：若 flipNext 没触发 flip 事件（例如已在末页），1.5s 后自行复位
        setTimeout(() => (autoFlipping = false), 1500);
      } else scrollByPage(1);
    }, autoSpeed * 1000);
  }
  autoBtn?.addEventListener('click', () => (autoTimer ? stopAuto() : startAuto()));

  // 拖动速度条：立即生效（重启计时器），并记住选择
  speedRange?.addEventListener('input', () => {
    const v = Number(speedRange.value);
    autoSpeed = Number.isFinite(v) ? Math.min(SPEED_MAX, Math.max(SPEED_MIN, v)) : SPEED_DEFAULT;
    try {
      localStorage.setItem(SPEED_KEY, String(autoSpeed));
    } catch {}
    renderSpeed();
    if (autoTimer) startAuto();
  });
  renderSpeed();
  // 读完页「重新阅读」：清进度回第 1 页
  document.getElementById('afterword-prev')?.addEventListener('click', () => {
    stopAuto();
    localStorage.removeItem(key);
    hideAfterword();
    if (mode === 'flip' && pf) {
      pf.turnToPage(0);
      setView(0, 1);
    } else {
      location.reload();
    }
  });
  function hide() {
    // 指针正悬停在工具栏上（读按钮/拖滑条）时不隐藏，稍后再试
    if (chrome.matches(':hover')) {
      hideTimer = setTimeout(hide, 800);
      return;
    }
    chrome.classList.remove('chrome-on');
  }
  // 桌面：仅当鼠标移近屏幕上/下边缘时呼出（视频播放器式），翻页操作零打扰
  window.addEventListener(
    'pointermove',
    (e) => {
      if (e.pointerType !== 'mouse') return;
      const y = e.clientY;
      if (y < 72 || window.innerHeight - y < 72) wake();
    },
    { passive: true }
  );
  // 键盘 Tab 聚焦到工具栏按钮时唤起（无障碍）
  chrome.addEventListener('focusin', wake);

  // 边缘条：点上下边缘呼出
  document.querySelectorAll<HTMLElement>('.edge-strip').forEach((strip) => {
    strip.addEventListener('click', wake);
  });

  // 翻页模式：左右 1/3 轻点翻页，中央轻点切换工具栏（仅触屏；桌面靠鼠标移动呼出+自动隐藏）
  let tapStart: { x: number; y: number; t: number } | null = null;
  flipStage.addEventListener('pointerdown', (e) => {
    tapStart = { x: e.clientX, y: e.clientY, t: Date.now() };
  });
  flipStage.addEventListener('pointerup', (e) => {
    if (!tapStart) return;
    const rawX = e.clientX - tapStart.x;
    const dy = Math.abs(e.clientY - tapStart.y);
    const dx = Math.abs(rawX);
    const dt = Date.now() - tapStart.t;
    tapStart = null;
    // 横向滑动：自己翻页（左滑前进 / 右滑后退）。阈值同时看横向位移与方向性，
    // 避免纵向滚动被误判成翻页。
    if (dx > 36 && dx > dy * 1.4 && dt < 800) {
      stopAuto();
      flipBy(rawX < 0 ? 1 : -1);
      return;
    }
    if (dx > 12 || dy > 12 || dt > 500) return; // 其余小幅抖动忽略
    const rect = flipStage.getBoundingClientRect();
    const x = (e.clientX - rect.left) / rect.width;
    stopAuto();
    if (e.pointerType === 'mouse') {
      // 桌面：左右半区翻页（工具栏由鼠标移动呼出，2.2s 无操作自动隐藏）
      tapFlipAtPoint(e.clientX, e.clientY, x < 0.5 ? -1 : 1);
    } else {
      // 触屏：两侧各 40% 翻页（竖屏下书页几乎占满屏宽，点左页靠中线处也必须能后退），
      // 中央 20% 呼出/隐藏工具栏（上下边缘条同样可呼出）。
      // 翻页传**真实触点**：卷页从你点的那个角落开始，左右观感才一致。
      if (x < 0.4) tapFlipAtPoint(e.clientX, e.clientY, -1);
      else if (x > 0.6) tapFlipAtPoint(e.clientX, e.clientY, 1);
      else chrome.classList.contains('chrome-on') ? hide() : wake();
    }
  });

  /* 滚动模式：轻点（不是滚动）呼出/隐藏工具栏；上下边缘条同样有效 */
  let scrollTap: { x: number; y: number; t: number } | null = null;
  scrollbook.addEventListener('pointerdown', (e) => {
    scrollTap = { x: e.clientX, y: e.clientY, t: Date.now() };
  });
  scrollbook.addEventListener('pointerup', (e) => {
    if (!scrollTap) return;
    const dx = Math.abs(e.clientX - scrollTap.x);
    const dy = Math.abs(e.clientY - scrollTap.y);
    const dt = Date.now() - scrollTap.t;
    scrollTap = null;
    if (dx > 12 || dy > 12 || dt > 500) return; // 滚动/滑动不当作点击
    chrome.classList.contains('chrome-on') ? hide() : wake();
  });

  // 首次进入：操作提示
  if (!localStorage.getItem('cl:hint')) {
    setTimeout(() => {
      showToast(STR.hint);
      localStorage.setItem('cl:hint', '1');
    }, 1200);
  }
</script>


---
import Base from '../../layouts/Base.astro';
import { getShelf, chapterNav, bookTitle } from '../../lib/books';
import { t, type Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
  book: any;
  chapter: any;
}
const { lang, book, chapter } = Astro.props;
const { prev, next } = chapterNav(book, chapter.slug);
const pages = chapter.pages;
const count = pages.length;
const base = lang === 'en' ? '/en' : '';
const ratio = chapter.ratio && chapter.ratio > 0 ? chapter.ratio : 8 / 9;
/** StPageFlip 页盒基准尺寸按真实比例取整 */
const flipW = Math.round(ratio >= 1 ? 900 : 800);
const flipH = Math.round(flipW / ratio);
---

<Base
  title={`${chapter.title}`}
  lang={lang}
  description={`${bookTitle(book, lang)} · ${chapter.title}`}
  ogImage={pages[0] ?? null}
  ogType="article"
  bodyClass="reader-page"
  chrome={false}
>
  <div
    id="reader"
    style={`--page-aspect:${ratio.toFixed(4)}`}
    data-page-aspect={ratio.toFixed(4)}
    data-book={book.slug}
    data-chapter={chapter.slug}
    data-count={count}
    data-base-path={base === '/en' ? '/en/' : '/'}
    data-prev={prev ? `${base}/read/${book.slug}/${prev.slug}/` : ''}
    data-next={next ? `${base}/read/${book.slug}/${next.slug}/` : ''}
    data-next-title={next?.title ?? ''}
    data-toast-restore={t(lang, 'reader.toastRestore')}
    data-toast-undo={t(lang, 'reader.undo')}
    data-end-kicker={t(lang, 'reader.endKicker')}
    data-end-last-kicker={t(lang, 'reader.endLastKicker')}
    data-end-next={t(lang, 'reader.endNext')}
    data-end-done={t(lang, 'reader.endDone')}
    data-mode-flip={t(lang, 'reader.modeFlip')}
    data-mode-scroll={t(lang, 'reader.modeScroll')}
  >
    <div class="chrome" id="chrome">
      <div class="chrome-top">
        <a class="cr-btn cr-back" href={`${base}/book/${book.slug}/`}>{t(lang, 'reader.back')}</a>
        <span class="cr-title">{bookTitle(book, lang)} · {chapter.title}</span>
        <span class="cr-actions">
          {
            prev && (
              <a class="cr-btn" id="lnk-prev" href={`${base}/read/${book.slug}/${prev.slug}/`}>
                {t(lang, 'reader.prev')}
              </a>
            )
          }
          {
            next && (
              <a class="cr-btn" id="lnk-next" href={`${base}/read/${book.slug}/${next.slug}/`}>
                {t(lang, 'reader.next')}
              </a>
            )
          }
          <button class="cr-btn" id="btn-thumbs" type="button">{t(lang, 'reader.thumbs')}</button>
          <button class="cr-btn" id="btn-mode" type="button">{t(lang, 'reader.modeScroll')}</button>
          <button class="cr-btn" id="btn-full" type="button">{t(lang, 'reader.full')}</button>
          <button class="cr-btn" id="btn-theme" type="button" aria-label={t(lang, 'theme.toggle')}><span class="icon-moon" aria-hidden="true">☾</span><span class="icon-sun" aria-hidden="true">☀</span></button>
        </span>
      </div>
      <div class="chrome-bottom">
        <input type="range" id="slider" min="1" max={count} value="1" step="1" aria-label="页码滑条" />
        <span id="page-indicator" aria-live="polite">1 / {count}</span>
      </div>
    </div>

    <!-- 滚动模式（默认可见 = 无 JS 也能读） -->
    <div id="scrollbook">
      {
        pages.map((url: string, i: number) => (
          <div class="scroll-page" data-idx={i}>
            <picture>
              <source srcset={url} type="image/webp" />
              <img
                src={url.replace(/\.webp$/, '.jpg')}
                alt={t(lang, 'reader.pageAlt', { n: i + 1 })}
                loading="lazy"
                decoding="async"
                draggable={false}
              />
            </picture>
          </div>
        ))
      }
    </div>

    <!-- 翻页模式 -->
    <div class="flip-stage" id="flip-stage" hidden>
      <div id="flipbook">
        {
          pages.map((url: string, i: number) => (
            <div class="pf-page">
              <img
                data-src={url}
                data-jpg={url.replace(/\.webp$/, '.jpg')}
                alt={t(lang, 'reader.pageAlt', { n: i + 1 })}
                draggable={false}
              />
            </div>
          ))
        }
      </div>
    </div>

    <!-- 缩略图网格 -->
    <div id="thumbs" hidden>
      <button class="cr-btn thumbs-close" id="btn-thumbs-close" type="button">✕</button>
      <div class="thumbs-grid">
        {
          pages.map((url: string, i: number) => (
            <button type="button" data-page={i + 1} aria-label={t(lang, 'reader.jumpAlt', { n: i + 1 })}>
              <img data-src={url} data-jpg={url.replace(/\.webp$/, '.jpg')} alt="" loading="lazy" />
              <span>{i + 1}</span>
            </button>
          ))
        }
      </div>
    </div>

    <!-- 章末引导卡 -->
    <div id="endcard" hidden>
      <a id="endcard-link" href="#">
        <span class="endcard-kicker" id="endcard-kicker" />
        <span class="endcard-title" id="endcard-title" />
      </a>
      <a class="endcard-back" href={`${base}/book/${book.slug}/`}>{t(lang, 'reader.backHome')}</a>
    </div>

    <div id="toast" hidden>
      <span id="toast-text" />
      <button id="toast-undo" type="button" hidden />
    </div>

    <noscript>
      <style>
        .chrome { display: none !important; }
      </style>
    </noscript>
  </div>
</Base>

<script>
  import { PageFlip } from 'page-flip';

  const root = document.getElementById('reader')!;
  const bookSlug = root.dataset.book!;
  const chapterSlug = root.dataset.chapter!;
  const count = Number(root.dataset.count);
  const nextUrl = root.dataset.next || null;
  const nextTitle = root.dataset.nextTitle || '';
  const STR = {
    toastRestore: root.dataset.toastRestore!,
    toastUndo: root.dataset.toastUndo!,
    endKicker: root.dataset.endKicker!,
    endLastKicker: root.dataset.endLastKicker!,
    endNext: root.dataset.endNext!,
    endDone: root.dataset.endDone!,
    modeFlip: root.dataset.modeFlip!,
    modeScroll: root.dataset.modeScroll!,
  };
  const key = `cl:progress:${bookSlug}:${chapterSlug}`;

  const chrome = document.getElementById('chrome')!;
  const scrollbook = document.getElementById('scrollbook')!;
  const flipStage = document.getElementById('flip-stage')!;
  const flipbook = document.getElementById('flipbook')!;
  const slider = document.getElementById('slider') as HTMLInputElement;
  const indicator = document.getElementById('page-indicator')!;
  const thumbs = document.getElementById('thumbs')!;
  const endcard = document.getElementById('endcard')!;
  const endcardLink = document.getElementById('endcard-link') as HTMLAnchorElement;
  const endcardKicker = document.getElementById('endcard-kicker')!;
  const endcardTitle = document.getElementById('endcard-title')!;
  const toast = document.getElementById('toast')!;
  const toastText = document.getElementById('toast-text')!;
  const toastUndo = document.getElementById('toast-undo') as HTMLButtonElement;
  const modeBtn = document.getElementById('btn-mode') as HTMLButtonElement;

  const saved = Math.min(Math.max(Number(localStorage.getItem(key) ?? 1) || 1, 1), count);
  let mode: 'flip' | 'scroll' = localStorage.getItem('cl:mode') === 'scroll' ? 'scroll' : 'flip';

  // 页盒基准尺寸按真实页宽高比现算（与服务端 --page-aspect 同源）
  const pageAspectCfg = Number(root.dataset.pageAspect) || 8 / 9;
  const flipW = Math.round(pageAspectCfg >= 1 ? 900 : 800);
  const flipH = Math.round(flipW / pageAspectCfg);

  let pf: PageFlip | null = null;
  let flipImgs: HTMLImageElement[] = [];
  let sections: HTMLElement[] = [];
  let orientation: 'portrait' | 'landscape' = 'portrait';
  let endShown = false;
  let toastTimer: ReturnType<typeof setTimeout> | undefined;

  const save = (p: number) => {
    localStorage.setItem(key, String(p));
    localStorage.setItem('cl:last', `${bookSlug}:${chapterSlug}`);
  };

  const setIndicator = (p: number) => {
    indicator.textContent = `${p} / ${count}`;
    if (Number(slider.value) !== p) slider.value = String(p);
  };

  /** WebP 支持一次性检测；不支持（Safari ≤13 / 老 WebView）则取同名 JPEG */
  const WEBP_OK = document
    .createElement('canvas')
    .toDataURL('image/webp')
    .startsWith('data:image/webp');
  const srcFor = (url: string) => (WEBP_OK ? url : (url.replace(/\.webp$/, '.jpg') ?? url));

  /** 激活一张懒加载图：按能力取 webp 或 jpg，只下载一种 */
  function activate(img: HTMLImageElement) {
    const raw = img.dataset.src;
    if (raw && !img.src) img.src = srcFor(raw);
  }

  function preloadFlip(cur: number) {
    const from = Math.max(0, cur - 2);
    const to = Math.min(count - 1, cur + 3);
    for (let i = from; i <= to; i++) {
      const img = flipImgs[i];
      if (img?.dataset.src && !img.src) activate(img);
    }
  }

  function showToast(text: string, undo?: () => void) {
    toastText.textContent = text;
    toastUndo.textContent = STR.toastUndo;
    toastUndo.hidden = !undo;
    toastUndo.onclick = undo ?? null;
    toast.hidden = false;
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => (toast.hidden = true), 4200);
  }

  function updateEndcard(p: number) {
    const atEnd = mode === 'scroll' ? p >= count : orientation === 'portrait' ? p >= count : p >= count - 1;
    if (atEnd && !endShown) {
      endShown = true;
      if (nextUrl) {
        endcardKicker.textContent = STR.endKicker;
        endcardTitle.textContent = STR.endNext.replace('{t}', nextTitle);
        endcardLink.href = nextUrl;
      } else {
        endcardKicker.textContent = STR.endLastKicker;
        endcardTitle.textContent = STR.endDone;
        endcardLink.href = root.dataset.basePath || '/';
      }
      endcard.hidden = false;
    } else if (!atEnd && endShown) {
      endShown = false;
      endcard.hidden = true;
    }
  }

  /* ---------- 翻页模式 ---------- */
  function fitFlip() {
    if (!pf) return;
    const stage = flipStage.getBoundingClientRect();
    const pad = { x: 20, y: 116 };
    const availW = stage.width - pad.x;
    const availH = stage.height - pad.y;
    const pageAspect = Number(root.dataset.pageAspect) || 8 / 9;
    const pageW =
      orientation === 'portrait'
        ? Math.min(availW, availH * pageAspect)
        : Math.min(availW / 2, availH * pageAspect);
    flipbook.style.width = `${Math.floor(pageW * (orientation === 'portrait' ? 1 : 2))}px`;
    window.dispatchEvent(new Event('resize'));
  }

  function initFlip(startPage: number) {
    scrollbook.hidden = true;
    flipStage.hidden = false;
    modeBtn.textContent = STR.modeScroll;

    pf = new PageFlip(flipbook, {
      width: flipW,
      height: flipH,
      size: 'stretch',
      minWidth: 320,
      maxWidth: Math.round(flipW * 1.15),
      minHeight: 360,
      maxHeight: Math.round(flipH * 1.15),
      usePortrait: true,
      showCover: false,
      mobileScrollSupport: true,
      maxShadowOpacity: 0.5,
      flippingTime: 620,
      swipeDistance: 14,
      startPage: startPage - 1,
    });
    pf.loadFromHTML(flipbook.querySelectorAll('.pf-page'));
    flipImgs = [...flipbook.querySelectorAll('img')];

    pf.on('flip', (e: { data: number }) => {
      const idx = Number(e.data ?? 0);
      setIndicator(idx + 1);
      save(idx + 1);
      preloadFlip(idx);
      updateEndcard(idx + 1);
    });
    pf.on('changeOrientation', (e: { data: 'portrait' | 'landscape' }) => {
      orientation = e.data;
      fitFlip();
      updateEndcard(Number(slider.value));
    });
    pf.on('init', () => {
      orientation = pf!.getOrientation();
      fitFlip();
    });

    setIndicator(startPage);
    preloadFlip(startPage - 1);
    updateEndcard(startPage);
    if (startPage > 1) {
      showToast(STR.toastRestore.replace('{p}', String(startPage)), () => {
        localStorage.removeItem(key);
        location.reload();
      });
    }
  }

  /* ---------- 滚动模式 ---------- */
  function initScroll(startPage: number) {
    flipStage.hidden = true;
    scrollbook.hidden = false;
    modeBtn.textContent = STR.modeFlip;

    sections = [...scrollbook.querySelectorAll<HTMLElement>('.scroll-page')];
    const io = new IntersectionObserver(
      (entries) => {
        for (const en of entries) {
          if (!en.isIntersecting) continue;
          const p = Number((en.target as HTMLElement).dataset.idx) + 1;
          setIndicator(p);
          save(p);
          updateEndcard(p);
        }
      },
      { root: scrollbook, threshold: 0.6 }
    );
    sections.forEach((s) => io.observe(s));

    if (startPage > 1) {
      requestAnimationFrame(() =>
        sections[startPage - 1]?.scrollIntoView({ behavior: 'instant' as ScrollBehavior })
      );
      showToast(STR.toastRestore.replace('{p}', String(startPage)), () => {
        localStorage.removeItem(key);
        location.reload();
      });
    }
  }

  function scrollByPage(dir: 1 | -1) {
    const cur = Number(slider.value);
    const target = sections[Math.min(count, Math.max(1, cur + dir)) - 1];
    target?.scrollIntoView({ behavior: 'smooth' });
  }

  /* ---------- 启动 ---------- */
  setIndicator(saved);
  if (mode === 'flip') initFlip(saved);
  else initScroll(saved);

  /* ---------- 控件 ---------- */
  slider.addEventListener('input', () => setIndicator(Number(slider.value)));
  slider.addEventListener('change', () => {
    const p = Number(slider.value);
    if (mode === 'flip') pf?.turnToPage(p - 1);
    else sections[p - 1]?.scrollIntoView({ behavior: 'smooth' });
  });

  modeBtn.addEventListener('click', () => {
    localStorage.setItem('cl:mode', mode === 'flip' ? 'scroll' : 'flip');
    location.reload();
  });

  document.getElementById('btn-full')!.addEventListener('click', () => {
    if (document.fullscreenElement) document.exitFullscreen();
    else document.documentElement.requestFullscreen?.().catch(() => {});
  });

  document.getElementById('btn-thumbs')!.addEventListener('click', () => {
    thumbs.hidden = false;
    thumbs.querySelectorAll('img').forEach((im) => {
      const el = im as HTMLImageElement;
      if (el.dataset.src && !el.src) activate(el);
    });
  });
  document.getElementById('btn-thumbs-close')!.addEventListener('click', () => (thumbs.hidden = true));
  thumbs.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-page]');
    if (!btn) return;
    const p = Number(btn.dataset.page);
    thumbs.hidden = true;
    if (mode === 'flip') pf?.turnToPage(p - 1);
    else sections[p - 1]?.scrollIntoView();
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !thumbs.hidden) {
      thumbs.hidden = true;
      return;
    }
    if (e.key === 'ArrowRight' || e.key === 'PageDown') {
      if (mode === 'flip') pf?.flipNext();
      else scrollByPage(1);
    } else if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
      if (mode === 'flip') pf?.flipPrev();
      else scrollByPage(-1);
    }
  });

  document.getElementById('btn-theme')!.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('cl:theme', next);
    } catch {}
  });

  /* ---------- chrome 自动隐藏 ---------- */
  let hideTimer: ReturnType<typeof setTimeout>;
  const wake = () => {
    chrome.classList.add('chrome-on');
    clearTimeout(hideTimer);
    hideTimer = setTimeout(() => chrome.classList.remove('chrome-on'), 2600);
  };
  ['pointermove', 'pointerdown', 'keydown', 'touchstart'].forEach((ev) =>
    window.addEventListener(ev, wake, { passive: true })
  );
  wake();
</script>

<style>
  body.reader-page { background: var(--reader-bg); overflow: hidden; }

  #reader { position: fixed; inset: 0; }

  .chrome {
    position: fixed;
    inset-inline: 0;
    inset-block: 0;
    z-index: 40;
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
  }
  .chrome.chrome-on { opacity: 1; pointer-events: auto; }
  .chrome-top,
  .chrome-bottom { position: absolute; left: 0; right: 0; display: flex; align-items: center; gap: 14px; }
  .chrome-top {
    top: 0;
    padding: 10px 14px;
    padding-top: max(10px, env(safe-area-inset-top));
    background: linear-gradient(180deg, var(--scrim), transparent);
  }
  .chrome-bottom {
    bottom: 0;
    padding: 8px 16px;
    padding-bottom: max(8px, env(safe-area-inset-bottom));
    background: linear-gradient(0deg, var(--scrim), transparent);
  }
  .cr-btn {
    border: none;
    background: none;
    padding: 6px 10px;
    color: var(--paper-dim);
    font-size: 13px;
    letter-spacing: 0.08em;
    cursor: pointer;
    white-space: nowrap;
    transition: color 0.2s ease;
  }
  .cr-btn:hover { color: var(--lamp); }
  #btn-theme .icon-sun { display: none; }
  [data-theme='light'] #btn-theme .icon-sun { display: inline; }
  [data-theme='light'] #btn-theme .icon-moon { display: none; }
  .cr-title {
    flex: 1;
    font-size: 13px;
    color: var(--paper-dim);
    letter-spacing: 0.06em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-align: center;
  }
  .cr-actions { display: flex; align-items: center; }
  #slider { flex: 1; accent-color: var(--lamp); height: 22px; }
  #page-indicator {
    font-family: var(--font-latin);
    font-size: 13px;
    color: var(--paper-dim);
    min-width: 64px;
    text-align: center;
    letter-spacing: 0.08em;
  }
  @media (max-width: 720px) {
    .cr-title { display: none; }
    #lnk-prev, #lnk-next { display: none; }
  }

  #scrollbook {
    position: absolute;
    inset: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scroll-snap-type: y mandatory;
  }
  #scrollbook[hidden] { display: none; }
  .scroll-page {
    height: 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60px 10px 72px;
  }
  .scroll-page img {
    max-width: min(94vw, 740px);
    max-height: 100%;
    border-radius: 2px;
    box-shadow: var(--page-shadow);
    background: #15151b;
  }

  .flip-stage {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 58px 10px 66px;
  }
  .flip-stage[hidden] { display: none; }
  #flipbook { max-width: 100%; }
  .pf-page { background: #0d0d12; }
  .pf-page img {
    width: 100%;
    height: 100%;
    object-fit: contain; /* 页盒比例=页面真实比例时无黑边；异常页不裁切 */
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
  }

  #thumbs {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: var(--overlay);
    overflow-y: auto;
    padding: 64px 4vw 44px;
  }
  .thumbs-close { position: fixed; top: 12px; right: 14px; }
  .thumbs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(92px, 1fr));
    gap: 12px;
    max-width: 920px;
    margin-inline: auto;
  }
  .thumbs-grid button {
    position: relative;
    padding: 0;
    aspect-ratio: var(--page-aspect, 8 / 9);
    border: 1px solid var(--line);
    border-radius: 3px;
    overflow: hidden;
    background: var(--card-bg);
    cursor: pointer;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .thumbs-grid button:hover { border-color: var(--lamp); transform: translateY(-2px); }
  .thumbs-grid img { width: 100%; height: 100%; object-fit: cover; opacity: 0.92; }
  .thumbs-grid span {
    position: absolute;
    right: 4px;
    bottom: 3px;
    font-family: var(--font-latin);
    font-size: 11px;
    color: var(--paper);
    text-shadow: 0 1px 3px #000;
  }

  #endcard {
    position: fixed;
    left: 50%;
    bottom: 96px;
    transform: translateX(-50%);
    z-index: 50;
    text-align: center;
    animation: endrise 0.4s ease both;
  }
  @keyframes endrise {
    from { opacity: 0; transform: translate(-50%, 12px); }
    to { opacity: 1; transform: translate(-50%, 0); }
  }
  #endcard-link {
    display: block;
    background: linear-gradient(180deg, var(--lamp-bright), var(--lamp));
    color: #2a1d07;
    padding: 13px 30px;
    border-radius: 4px;
    font-weight: 600;
    letter-spacing: 0.06em;
    box-shadow: 0 10px 34px rgba(232, 180, 90, 0.33);
    transition: transform 0.2s ease;
  }
  #endcard-link:hover { transform: translateY(-2px); }
  .endcard-kicker { display: block; font-size: 11px; letter-spacing: 0.3em; opacity: 0.72; }
  .endcard-title { display: block; font-family: var(--font-display); font-size: 16px; }
  .endcard-back { display: inline-block; margin-top: 10px; font-size: 12.5px; color: var(--paper-dim); }
  .endcard-back:hover { color: var(--lamp); }

  #toast {
    position: fixed;
    left: 50%;
    bottom: 190px;
    transform: translateX(-50%);
    z-index: 70;
    display: flex;
    gap: 14px;
    align-items: center;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 10px 18px;
    font-size: 13px;
  }
  #toast button {
    border: none;
    background: none;
    color: var(--lamp);
    cursor: pointer;
    font-size: 13px;
    letter-spacing: 0.06em;
  }
</style>

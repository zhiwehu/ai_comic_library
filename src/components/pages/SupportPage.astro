---
import Base from '../../layouts/Base.astro';
import { SUPPORT } from '../../site.config';
import { href, t, type Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const anyChannel = !!(SUPPORT.wechatReward || SUPPORT.afdian || SUPPORT.store || SUPPORT.contact);
---

<Base
  title={t(lang, 'support.title')}
  lang={lang}
  description={t(lang, 'support.lead')}
  bodyClass="support-page"
>
  <article class="wrap support">
    <p class="sup-crumb">
      <a href={href(lang, '/')}>{t(lang, 'support.crumb')}</a>
    </p>

    <header class="sup-head">
      <p class="sup-kicker">{t(lang, 'support.kicker')}</p>
      <h1>{t(lang, 'support.title')}</h1>
      <p class="sup-lead">{t(lang, 'support.lead')}</p>
    </header>

    {
      anyChannel ? (
        <div class="sup-grid">
          {SUPPORT.wechatReward && (
            <section class="sup-card">
              <h2>{t(lang, 'support.wechatTitle')}</h2>
              <img
                class="sup-qr"
                src={SUPPORT.wechatReward}
                alt={t(lang, 'support.wechatTitle')}
                width="220"
                height="220"
                loading="lazy"
              />
              <p>{t(lang, 'support.wechatDesc')}</p>
            </section>
          )}
          {SUPPORT.afdian && (
            <section class="sup-card">
              <h2>{t(lang, 'support.afdianTitle')}</h2>
              <p>{t(lang, 'support.afdianDesc')}</p>
              <a class="btn btn-lamp" href={SUPPORT.afdian} target="_blank" rel="noopener">
                {t(lang, 'support.afdianCta')} →
              </a>
            </section>
          )}
          {SUPPORT.store && (
            <section class="sup-card">
              <h2>{t(lang, 'support.storeTitle')}</h2>
              <p>{t(lang, 'support.storeDesc')}</p>
              <a class="btn" href={SUPPORT.store} target="_blank" rel="noopener">
                {t(lang, 'support.storeCta')} →
              </a>
            </section>
          )}
          {SUPPORT.contact && (
            <section class="sup-card">
              <h2>{t(lang, 'support.bizTitle')}</h2>
              <p>{t(lang, 'support.bizDesc')}</p>
              <a class="btn btn-ghost" href={SUPPORT.contact}>
                {t(lang, 'support.bizCta')} →
              </a>
            </section>
          )}
        </div>
      ) : (
        <div class="sup-empty">
          <p>{t(lang, 'support.empty')}</p>
          <a class="btn btn-ghost" href={href(lang, '/')}>{t(lang, 'support.crumb')}</a>
        </div>
      )
    }

    <p class="sup-note">{t(lang, 'support.note')}</p>
  </article>
</Base>

<style>
  .support {
    max-width: 880px;
    padding-block: clamp(28px, 6vw, 64px) clamp(48px, 8vw, 96px);
  }
  .sup-crumb {
    margin: 0 0 clamp(18px, 4vw, 34px);
    font-size: 13px;
  }
  .sup-crumb a {
    color: var(--paper-dim);
    border-bottom: 1px solid transparent;
    transition: color 0.2s ease;
  }
  .sup-crumb a:hover { color: var(--lamp); }
  .sup-kicker {
    font-size: 11px;
    letter-spacing: 0.34em;
    color: var(--lamp);
    margin: 0 0 12px;
  }
  .sup-head h1 {
    font-size: clamp(28px, 5vw, 42px);
    margin: 0 0 14px;
  }
  .sup-lead {
    color: var(--paper-dim);
    font-size: 14.5px;
    line-height: 1.8;
    max-width: 52ch;
    margin: 0;
  }
  .sup-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
    margin-top: clamp(26px, 5vw, 44px);
  }
  .sup-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px 22px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--card-bg);
  }
  .sup-card h2 {
    margin: 0;
    font-size: 17.5px;
  }
  .sup-card p {
    margin: 0;
    flex: 1;
    color: var(--paper-dim);
    font-size: 13.5px;
    line-height: 1.75;
  }
  .sup-card .btn { align-self: flex-start; }
  .sup-qr {
    width: min(200px, 100%);
    height: auto;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: #fff;
    padding: 8px;
    box-sizing: content-box;
    align-self: center;
  }
  .sup-empty {
    margin-top: clamp(26px, 5vw, 44px);
    padding: 40px 24px;
    border: 1px dashed var(--line);
    border-radius: 16px;
    text-align: center;
    color: var(--paper-dim);
    display: grid;
    gap: 18px;
    justify-items: center;
  }
  .sup-empty p { margin: 0; font-size: 14px; }
  .sup-note {
    margin: clamp(30px, 6vw, 48px) 0 0;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    color: var(--paper-dim);
    font-size: 12px;
    line-height: 1.7;
  }
</style>

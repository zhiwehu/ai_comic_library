---
import '../styles/global.css';
import { SITE } from '../site.config';
import { t, type Lang } from '../lib/i18n';

interface Props {
  title: string;
  lang?: Lang;
  description?: string;
  ogImage?: string | null;
  ogType?: string;
  bodyClass?: string;
  chrome?: boolean;
}

const {
  title,
  lang = 'zh',
  description = t(lang, 'site.desc'),
  ogImage = null,
  ogType = 'website',
  bodyClass = '',
  chrome = true,
} = Astro.props;

const ogImageAbs = ogImage
  ? new URL(ogImage.replace(/\.webp$/, '.jpg'), Astro.site).href // OG 平台对 webp 支持参差，统一给 jpg
  : null;

/** 语言切换目标：zh ↔ en（同一路径） */
const path = Astro.url.pathname;
const altPath =
  lang === 'zh'
    ? path === '/'
      ? '/en/'
      : `/en${path}`
    : path.replace(/^\/en(?=\/|$)/, '') || '/';

const htmlLang = lang === 'en' ? 'en' : 'zh-CN';
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} · {t(lang, 'site.name')}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0b0f" />
    <!-- 主题：优先用户选择，否则跟随系统；内联执行避免闪屏 -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('cl:theme');
          var theme =
            saved === 'light' || saved === 'dark'
              ? saved
              : matchMedia('(prefers-color-scheme: light)').matches
                ? 'light'
                : 'dark';
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={t(lang, 'site.name')} href="/rss.xml" />
    <link rel="alternate" hreflang="zh" href={new URL(lang === 'zh' ? path : altPath, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(lang === 'en' ? path : altPath, Astro.site)} />
    <meta property="og:site_name" content={t(lang, 'site.name')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {ogImageAbs && <meta property="og:image" content={ogImageAbs} />}
    <meta name="twitter:card" content={ogImageAbs ? 'summary_large_image' : 'summary'} />
    {ogImageAbs && <meta name="twitter:image" content={ogImageAbs} />}
  </head>
  <body class={bodyClass}>
    {
      chrome && (
        <header class="site-head wrap">
          <a class="brand" href={lang === 'en' ? '/en/' : '/'}>
            <img class="brand-mark" src="/mark.svg" alt="" width="30" height="30" />
            <span class="brand-name">{t(lang, 'site.name')}</span>
            <span class="brand-latin">{SITE.latinName}</span>
          </a>
          <nav>
            <a href={lang === 'en' ? '/en/' : '/'}>{t(lang, 'nav.shelf')}</a>
            <a href="/rss.xml">{t(lang, 'nav.rss')}</a>
            <button
              class="theme-toggle"
              id="theme-toggle"
              type="button"
              aria-label={t(lang, 'theme.toggle')}
              title={t(lang, 'theme.toggle')}
            >
              <span class="icon-moon" aria-hidden="true">☾</span>
              <span class="icon-sun" aria-hidden="true">☀</span>
            </button>
            <a class="lang-switch" href={altPath} aria-label={t(lang, 'switch.label')}>
              {t(lang, 'switch.to')}
            </a>
          </nav>
        </header>
      )
    }
    <main>
      <slot />
    </main>
    {
      chrome && (
        <footer class="site-foot">
          <div class="wrap">
            <p class="motto">{t(lang, 'footer.motto')}</p>
            <p class="fine">
              {SITE.domain} · <a href="/rss.xml">{t(lang, 'footer.rss')}</a> · {t(lang, 'footer.fine')} · 由
              <a
                class="aiti-credit"
                href="https://www.getaiti.com"
                target="_blank"
                rel="noopener"
                title="AITi · getaiti.com"
              >
                <img src="/getaiti-logo.png" alt="AITi" loading="lazy" />
              </a>
              出品
            </p>
          </div>
        </footer>
      )
    }
  </body>
</html>

<script>
  // 主题切换：写 localStorage + 换 data-theme，无刷新过渡
  function bindThemeToggle(btn: HTMLElement | null) {
    btn?.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('cl:theme', next);
      } catch {}
      document.querySelector('meta[name="theme-color"]')
        ?.setAttribute('content', next === 'light' ? '#f1eadb' : '#0b0b0f');
    });
  }
  bindThemeToggle(document.getElementById('theme-toggle'));
</script>

---
import Reader from '../../../../components/pages/Reader.astro';
import { getShelf, chapterNav } from '../../../../lib/books';

export async function getStaticPaths() {
  const shelf = await getShelf();
  return shelf.flatMap((book) =>
    book.chapters.map((chapter) => ({
      params: { book: book.slug, chapter: chapter.slug },
      props: { book, chapter },
    }))
  );
}

const { book, chapter } = Astro.props;
---

<Reader lang="en" book={book} chapter={chapter} />

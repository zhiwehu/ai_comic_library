---
import BookDetail from '../../../components/pages/BookDetail.astro';
import { getShelf } from '../../../lib/books';

export async function getStaticPaths() {
  const shelf = await getShelf();
  return shelf.map((book) => ({ params: { slug: book.slug }, props: { book } }));
}

const { book } = Astro.props;
---

<BookDetail lang="en" book={book} />

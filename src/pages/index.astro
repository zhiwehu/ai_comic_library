---
import Base from '../layouts/Base.astro';
import BookCard from '../components/BookCard.astro';
import { getShelf, TYPE_LABEL, fmtDate } from '../lib/books';

const shelf = await getShelf();
const featured = shelf[0] ?? null;
const ch = featured?.latest ?? null;
const leftPage = ch?.pages[0];
const rightPage = ch?.pages[1] ?? ch?.pages[0];
---

<Base title="书架 · 深夜书房" ogImage={featured?.coverUrl ?? null}>
  {
    featured && ch && leftPage ? (
      <section class="hero">
        <div class="motes" aria-hidden="true">
          <i /><i /><i /><i /><i />
        </div>
        <div class="wrap hero-inner">
          <p class="hero-kicker">
            最新上架 · 《{featured.title}》 · {TYPE_LABEL[featured.type]} · {fmtDate(ch.date)}
          </p>
          <div class="open-book">
            <div class="ob-page ob-left">
              <img src={leftPage} alt="" fetchpriority="high" />
            </div>
            {rightPage && (
              <div class="ob-page ob-right">
                <img src={rightPage} alt="" />
              </div>
            )}
            <div class="ob-gutter" aria-hidden="true" />
          </div>
          <h1 class="hero-title">{ch.title}</h1>
          <div class="hero-actions">
            <a class="btn btn-lamp" href={`/read/${featured.slug}/${ch.slug}/`}>
              翻 开 这 本 书
            </a>
            <a class="btn btn-ghost" id="continue-link" hidden href="#" />
          </div>
        </div>
      </section>
    ) : (
      <section class="hero hero-empty wrap">
        <h1 class="hero-title">书房还空着</h1>
        <p class="hero-kicker">用 <code>pnpm run publish</code> 上架第一本书。</p>
      </section>
    )
  }

  <section class="shelf wrap" id="shelf">
    <header class="shelf-head">
      <h2>藏书架</h2>
      <p class="shelf-sub">共 {shelf.length} 本 · 按最近更新排列</p>
    </header>
    <div class="shelf-grid">
      {shelf.map((b) => <BookCard book={b} />)}
    </div>
  </section>
</Base>

<script>
  // 「继续上次」：cl:last 记录最近阅读的书:章
  const link = document.getElementById('continue-link') as HTMLAnchorElement | null;
  const last = localStorage.getItem('cl:last');
  if (link && last) {
    const sep = last.lastIndexOf(':');
    const b = last.slice(0, sep);
    const c = last.slice(sep + 1);
    const p = Number(localStorage.getItem(`cl:progress:${b}:${c}`) ?? 0);
    if (b && c && p > 0) {
      link.href = `/read/${b}/${c}/`;
      link.textContent = `继续上次 · 读到第 ${p} 页`;
      link.hidden = false;
    }
  }
</script>

<style>
  /* ---------- 首屏：开卷 ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(40px, 7vw, 80px) clamp(48px, 8vw, 92px);
    border-bottom: 1px solid var(--line);
  }
  /* 台灯光晕 */
  .hero::before {
    content: '';
    position: absolute;
    inset: -50% -20% auto;
    height: 150%;
    pointer-events: none;
    background:
      radial-gradient(600px 440px at 74% -80px, rgba(232, 180, 90, 0.17), rgba(232, 180, 90, 0.045) 46%, transparent 70%),
      radial-gradient(420px 340px at 18% -40px, rgba(232, 180, 90, 0.07), transparent 65%);
  }
  .hero-inner { position: relative; text-align: center; }

  .hero-kicker {
    margin: 0 0 26px;
    font-size: 13px;
    letter-spacing: 0.22em;
    color: var(--paper-dim);
    animation: rise 0.9s 0.05s ease both;
  }
  .hero-kicker code {
    font-family: var(--font-latin);
    color: var(--lamp);
  }

  .open-book {
    position: relative;
    display: flex;
    width: min(88vw, 760px);
    margin-inline: auto;
    transform: perspective(1900px) rotateX(3.2deg);
    filter: drop-shadow(0 34px 54px rgba(0, 0, 0, 0.62));
    animation: settle 1.1s 0.15s cubic-bezier(0.2, 0.75, 0.3, 1) both;
  }
  .ob-page {
    width: 50%;
    aspect-ratio: 8 / 9;
    background: #17171d;
    overflow: hidden;
  }
  .ob-page img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ob-left {
    border-radius: 5px 0 0 7px;
    box-shadow: inset -22px 0 30px -22px rgba(0, 0, 0, 0.75);
    transform-origin: right center;
    animation: unfold-l 1.15s 0.15s cubic-bezier(0.2, 0.75, 0.3, 1) both;
  }
  .ob-right {
    border-radius: 0 5px 7px 0;
    box-shadow: inset 22px 0 30px -22px rgba(0, 0, 0, 0.75);
    transform-origin: left center;
    animation: unfold-r 1.15s 0.3s cubic-bezier(0.2, 0.75, 0.3, 1) both;
  }
  .ob-gutter {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 44px;
    transform: translateX(-50%);
    background: linear-gradient(
      90deg,
      transparent,
      rgba(0, 0, 0, 0.5) 46%,
      rgba(0, 0, 0, 0.62) 50%,
      rgba(0, 0, 0, 0.5) 54%,
      transparent
    );
    pointer-events: none;
  }

  .hero-title {
    margin: 34px auto 20px;
    font-size: clamp(21px, 3.4vw, 30px);
    letter-spacing: 0.1em;
    animation: rise 0.9s 0.45s ease both;
  }
  .hero-actions {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
    animation: rise 0.9s 0.6s ease both;
  }

  /* 灯尘 */
  .motes i {
    position: absolute;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgba(246, 207, 134, 0.55);
    filter: blur(1px);
    opacity: 0;
    animation: drift 16s linear infinite;
  }
  .motes i:nth-child(1) { left: 14%; top: 68%; animation-delay: 0s; }
  .motes i:nth-child(2) { left: 30%; top: 78%; animation-delay: -6s; animation-duration: 19s; }
  .motes i:nth-child(3) { left: 62%; top: 60%; animation-delay: -3s; animation-duration: 14s; }
  .motes i:nth-child(4) { left: 80%; top: 80%; animation-delay: -9s; animation-duration: 21s; }
  .motes i:nth-child(5) { left: 48%; top: 72%; animation-delay: -12s; animation-duration: 17s; }

  @keyframes drift {
    0% { transform: translate(0, 10px); opacity: 0; }
    18% { opacity: 0.5; }
    85% { opacity: 0.12; }
    100% { transform: translate(8px, -52px); opacity: 0; }
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes settle {
    from { opacity: 0; transform: perspective(1900px) rotateX(3.2deg) translateY(18px); }
    to { opacity: 1; transform: perspective(1900px) rotateX(3.2deg) translateY(0); }
  }
  @keyframes unfold-l {
    from { transform: rotateY(-26deg); }
    to { transform: rotateY(0); }
  }
  @keyframes unfold-r {
    from { transform: rotateY(26deg); }
    to { transform: rotateY(0); }
  }

  /* ---------- 藏书架 ---------- */
  .shelf { padding-top: clamp(44px, 7vw, 84px); }
  .shelf-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: clamp(30px, 5vw, 52px);
  }
  .shelf-head h2 {
    margin: 0;
    font-size: 22px;
    letter-spacing: 0.24em;
  }
  .shelf-sub {
    margin: 0;
    font-size: 13px;
    color: var(--paper-faint);
    letter-spacing: 0.1em;
  }
  .shelf-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(138px, 1fr));
    column-gap: 24px;
    row-gap: 54px;
  }
  @media (max-width: 480px) {
    .shelf-grid { grid-template-columns: repeat(auto-fill, minmax(118px, 1fr)); column-gap: 18px; }
  }
</style>
